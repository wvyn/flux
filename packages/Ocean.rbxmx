				<ProtectedString name="Source"><![CDATA[--[[
	The ocean's look, its waves, and how fine it's laid out on each kind of
	device (Ocean, its workers, and Waves on the server too).

		SeaLevel       -- studs: the water's height at rest
		Colors         -- the water's colours, deepest trough to foam
		Material       -- the base material its MaterialVariants are for
		Frames         -- the ripples: an animated normal map, a frame a
		                  MaterialVariant (see below)
		Waves          -- the swells and chop (see Waves): Length and
		                  Amplitude in studs, Direction in degrees off
		                  WindDirection
		Tiers          -- how fine the water is round the camera, by device
		                  (see Clipmap)

	The frames are made in Studio (a variant's maps can't be set in game):
	MaterialService.Ocean holds Ocean00 to Ocean63, each one frame of the
	normal map, all else the same (StudsPerTile 16, Organic so it doesn't
	look tiled, glossy for the sun's glints). Their colour's the water's
	own: each point of it is coloured by how high the waves have it.
]]

return {
	SeaLevel = 0,

	-- The water's colour sunk ColorDepth studs or more (Deep), at rest
	-- (Body), lifted ColorHeight studs or more (Crest), and where a crest
	-- bunches the water up hardest (Foam): from FoamFrom of the way to
	-- folding over (Choppiness at the most), all foam by FoamFull. Each
	-- point's shown in one of ColorShades shades between (an even number),
	-- so its colour's only written when that changes.
	Colors = {
		Deep = Color3.fromRGB(10, 50, 70),
		Body = Color3.fromRGB(18, 80, 98),
		Crest = Color3.fromRGB(34, 114, 120),
		Foam = Color3.fromRGB(118, 162, 162),
	},
	ColorDepth = 4,
	ColorHeight = 4.2,
	FoamFrom = 0.32,
	FoamFull = 0.6,
	ColorShades = 24,

	-- Under water (Underwater): blurred Blur, tinted Tint (Contrast,
	-- Saturation and Brightness on top), fogged FogColor from FogStart to
	-- FogEnd (DeepFog and DeepFogEnd at DeepAt studs down and below), the
	-- fog cover round the camera (CoverSize studs across), eased in and out
	-- (Fade: a share of the way a second). With an Atmosphere (it
	-- switches the fog off), its Haze is eased to this instead, and a veil
	-- fades things on the way: a thinner cover VeilAt of the way out,
	-- VeilTransparency see-through.
	Underwater = {
		Haze = 0.1,
		VeilAt = 0.5,
		VeilTransparency = 0.45,
		Blur = 6,
		Tint = Color3.fromRGB(160, 214, 228),
		Contrast = 0.12,
		Saturation = -0.12,
		Brightness = -0.03,
		FogColor = Color3.fromRGB(30, 96, 114),
		DeepFog = Color3.fromRGB(8, 40, 58),
		FogStart = 0,
		FogEnd = 110,
		DeepFogEnd = 50,
		DeepAt = 60,
		CoverSize = 1000,
		Fade = 9,
	},

	Material = Enum.Material.SmoothPlastic,

	-- MaterialVariants Folder in MaterialService, each frame's Name (with
	-- its number), how many, and how many a second: round in four seconds.
	Frames = {
		Folder = "Ocean",
		Name = "Ocean%02d",
		Count = 64,
		Rate = 16,
	},

	-- Which way the swells run (degrees round from +X towards +Z).
	WindDirection = 30,
	-- Studs a second squared: how fast a wave of each length travels (deep
	-- water: the longer, the faster). A real sea's, at a stud to 0.28 m.
	Gravity = 35,
	-- The whole sea faster or slower than that.
	TimeScale = 1,
	-- 0 to 1: how sharp the crests are (the water carried to and fro and
	-- bunched under them). Shared out so they never fold over.
	Choppiness = 0.9,
	-- Where each wave starts in its cycle comes from this (the same on
	-- every screen and the server).
	Seed = 7,
	-- A rough sea: chop of every size over a long swell or two, the shorter
	-- the steeper (only as short as a tier's points can show: see Tiers).
	Waves = {
		{ Length = 180, Amplitude = 2.8, Direction = 0 },
		{ Length = 120, Amplitude = 2.4, Direction = 36 },
		{ Length = 84, Amplitude = 2, Direction = -28 },
		{ Length = 58, Amplitude = 1.55, Direction = 64 },
		{ Length = 42, Amplitude = 1.2, Direction = -58 },
		{ Length = 31, Amplitude = 0.9, Direction = 14 },
		{ Length = 23, Amplitude = 0.66, Direction = -84 },
		{ Length = 17, Amplitude = 0.48, Direction = 104 },
		{ Length = 13, Amplitude = 0.36, Direction = -36 },
		{ Length = 11, Amplitude = 0.28, Direction = 148 },
	},

	-- Past the clipmap's last ring the water's flat, out this far from the
	-- camera (beyond the haze).
	Horizon = 30000,
	-- A wave's shown only where the water's points are no more than its
	-- length over this apart, fading out over the last of that (from
	-- FadeStart of the way out).
	SamplesPerWave = 3.5,
	FadeStart = 0.55,

	-- Each kind of device: its clipmap (a middle square Grid quads across,
	-- its points Spacing studs apart, then Levels - 1 rings, each twice as
	-- coarse), how many Workers (Actors, run in parallel) share it, and how
	-- often a second it's moved: MaxRate at most, less while the workers'
	-- writes take more than Budget milliseconds a second (not under MinRate).
	-- Ripples false: they stand still unless the player turns them on (and
	-- their frames aren't downloaded till then).
	Tiers = {
		VeryLow = { Grid = 16, Spacing = 8, Levels = 3, Workers = 1, MaxRate = 20, MinRate = 10, Budget = 25, Ripples = false },
		Low = { Grid = 24, Spacing = 6, Levels = 4, Workers = 2, MaxRate = 30, MinRate = 15, Budget = 45 },
		Medium = { Grid = 32, Spacing = 4, Levels = 4, Workers = 3, MaxRate = 60, MinRate = 20, Budget = 70 },
		High = { Grid = 40, Spacing = 3, Levels = 4, Workers = 4, MaxRate = 60, MinRate = 30, Budget = 100 },
	},
	-- "VeryLow", "Low", "Medium" or "High" for every device; nil picks by
	-- the device and its graphics quality.
	Tier = nil :: string?,
}
]]></ProtectedString>
				<string name="ScriptGuid">{1C2C0580-2B00-4B17-BE59-A90182CCF207}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">OceanSettings</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">791632d9be0626cc0af91aa60000840c</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX322C0B188D444BE7B6F0B041C9D3A3A8">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--[[
	Shared (client and server). The ocean's waves: Gerstner waves, a few
	long swells and shorter waves across them, summed. The water at rest at
	a spot is carried round by each in a circle, up and down and to and fro
	along its way (as far as Choppiness has it), so crests come sharp and
	troughs broad, as at sea.

		const waves = Waves.Build(OceanSettings)
		Waves.Offset(waves, x, z, time) -- where the water at rest at (x, z)
		                                 -- is carried: dx, dy, dz
		Waves.HeightAt(waves, x, z, time) -- the surface over (x, z), from
		                                   -- sea level
		Waves.NormalAt(waves, x, z, time) -- the way up from it there
		Waves.Sample(waves, x, z, time) -- the surface over (x, z), and how
		                                 -- fast the water there's moving

	Time is the server's (workspace:GetServerTimeNow()), so every screen and
	the server have the same sea. These are the waves in full: the ocean
	leaves the shorter ones out far from the camera (Clipmap), where they
	can't be seen.
]]

const Waves = {}

-- Times HeightAt steps back from where the water's been carried to find
-- where it was at rest (each takes the miss down by Choppiness or more).
const HEIGHT_STEPS = 4

export type Wave = {
	Length: number,
	Amplitude: number,
	-- Its way across the water (a unit vector's x and z).
	DirectionX: number,
	DirectionZ: number,
	-- Radians a stud along its way (two pi over its length), and a second
	-- (deep water: the square root of gravity times that).
	Number: number,
	Speed: number,
	Phase: number,
	-- How far it carries the water along its way, over its amplitude.
	Steepness: number,
}

function Waves.Build(settings: any): { Wave }
	const list = settings.Waves
	const random = Random.new(settings.Seed)
	const waves = table.create(#list)
	for index, info in list do
		const angle = math.rad(settings.WindDirection + info.Direction)
		const number = 2 * math.pi / info.Length
		waves[index] = {
			Length = info.Length,
			Amplitude = info.Amplitude,
			DirectionX = math.cos(angle),
			DirectionZ = math.sin(angle),
			Number = number,
			Speed = math.sqrt(settings.Gravity * number) * settings.TimeScale,
			Phase = random:NextNumber(0, 2 * math.pi),
			-- (Shared out: all of them at their crests at once carry the water
			-- no more than Choppiness of the way to folding over.)
			Steepness = if info.Amplitude > 0 then settings.Choppiness / (number * info.Amplitude * #list) else 0,
		}
	end
	return waves
end

function Waves.Offset(waves: { Wave }, x: number, z: number, time: number): (number, number, number)
	local dx, dy, dz = 0, 0, 0
	for _, wave in waves do
		const theta = wave.Number * (wave.DirectionX * x + wave.DirectionZ * z) - wave.Speed * time + wave.Phase
		const along = wave.Steepness * wave.Amplitude * math.cos(theta)
		dx += wave.DirectionX * along
		dy += wave.Amplitude * math.sin(theta)
		dz += wave.DirectionZ * along
	end
	return dx, dy, dz
end

-- Where the water that's over (x, z) now was at rest.
const function restAt(waves: { Wave }, x: number, z: number, time: number): (number, number)
	local restX, restZ = x, z
	for _ = 1, HEIGHT_STEPS do
		const dx, _, dz = Waves.Offset(waves, restX, restZ, time)
		restX, restZ = x - dx, z - dz
	end
	return restX, restZ
end

function Waves.HeightAt(waves: { Wave }, x: number, z: number, time: number): number
	const restX, restZ = restAt(waves, x, z, time)
	const _, dy = Waves.Offset(waves, restX, restZ, time)
	return dy
end

-- The surface over (x, z), and the water's velocity there (studs a
-- second): what floating things ride and are carried along by.
function Waves.Sample(waves: { Wave }, x: number, z: number, time: number): (number, Vector3)
	const restX, restZ = restAt(waves, x, z, time)
	local height, vx, vy, vz = 0, 0, 0, 0
	for _, wave in waves do
		const theta = wave.Number * (wave.DirectionX * restX + wave.DirectionZ * restZ) - wave.Speed * time + wave.Phase
		const s, c = math.sin(theta), math.cos(theta)
		height += wave.Amplitude * s
		-- (Its turn goes back Speed radians a second.)
		const along = wave.Steepness * wave.Amplitude * wave.Speed * s
		vx += wave.DirectionX * along
		vy -= wave.Amplitude * wave.Speed * c
		vz += wave.DirectionZ * along
	end
	return height, Vector3.new(vx, vy, vz)
end

function Waves.NormalAt(waves: { Wave }, x: number, z: number, time: number): Vector3
	const restX, restZ = restAt(waves, x, z, time)
	local nx, ny, nz = 0, 1, 0
	for _, wave in waves do
		const theta = wave.Number * (wave.DirectionX * restX + wave.DirectionZ * restZ) - wave.Speed * time + wave.Phase
		const lift = wave.Number * wave.Amplitude
		const c = math.cos(theta)
		nx -= wave.DirectionX * lift * c
		nz -= wave.DirectionZ * lift * c
		ny -= wave.Steepness * lift * math.sin(theta)
	end
	return Vector3.new(nx, ny, nz).Unit
end

return Waves
]]></ProtectedString>
				<string name="ScriptGuid">{01A8CC63-AB54-48CC-AF6C-02C84D3EAA2B}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Waves</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">791632d9be0626cc0af91aa60000840e</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXCF1F8C01FB27415BA41982039375A12B">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--[[
	The water round the camera, laid out as a clipmap (for the ocean's
	workers): a fine square in the middle, then rings round it, each twice
	the size of the one inside with its points twice as far apart (so on
	screen they look about as close together), and past the last a flat
	skirt out to the horizon.

		const layout = Clipmap.Build(tier, waves, OceanSettings)

	The whole moves with the camera in steps of layout.Snap studs (two of
	the middle's spacing), so the middle's points stay on the same spots
	of the sea as it goes (nothing near the camera swims) and the rings'
	very nearly so. A level's outside edge meets the next ring's inside
	edge point for point; its odd points there (the ring has none) are put
	on the line between their neighbours (Stitch...), so no crack opens.

	Each level's cut into chunks (the middle into four, each ring into
	eight round it), so those off screen can be left be.

	A wave can only be shown where the points are close enough together
	for it: no more than its length over SamplesPerWave apart. Fades has,
	for each wave, how far from the camera it's whole (Start) and gone
	(Out): within the levels fine enough for it wherever the camera is in
	its step, so it's gone before the points get too far apart. The last
	level's outside edge is past every wave's Out, so it's flat where it
	meets the skirt.
]]

const Clipmap = {}

export type Chunk = {
	Level: number,
	Spacing: number,
	-- Quads across (x) and along (z).
	Columns: number,
	Rows: number,
	-- Its first point's place from the centre, its middle's, and how far it
	-- reaches either way of that (studs).
	OriginX: number,
	OriginZ: number,
	MidX: number,
	MidZ: number,
	HalfX: number,
	HalfZ: number,
	-- Its sides on its level's outside edge, next to a coarser ring.
	StitchLeft: boolean,
	StitchRight: boolean,
	StitchBottom: boolean,
	StitchTop: boolean,
	-- The nearest the camera can ever be to it, along the water.
	Nearest: number,
}

export type Fade = {
	Start: number,
	Out: number,
}

export type Layout = {
	Chunks: { Chunk },
	Snap: number,
	Fades: { Fade },
	-- The flat water past the last level: its inside edge is the last
	-- level's outside (Points quads to a side, point for point), and it
	-- reaches out through each of Rings (squares, studs from the centre).
	Skirt: { Points: number, Rings: { number } },
	-- How far the waves can carry the water along and up: a chunk's
	-- bounds grow this much either way.
	Reach: number,
	Height: number,
}

-- A ring's pieces in quarters of its width: where each starts across and
-- along, and how many quarters it is each way (the middle two-by-two
-- quarters are its hole). The middle square's, in quarters too.
const RING_PIECES = {
	{ 0, 0, 1, 1 },
	{ 1, 0, 2, 1 },
	{ 3, 0, 1, 1 },
	{ 0, 1, 1, 2 },
	{ 3, 1, 1, 2 },
	{ 0, 3, 1, 1 },
	{ 1, 3, 2, 1 },
	{ 3, 3, 1, 1 },
}
const MIDDLE_PIECES = {
	{ 0, 0, 2, 2 },
	{ 2, 0, 2, 2 },
	{ 0, 2, 2, 2 },
	{ 2, 2, 2, 2 },
}

-- How near a point within `slack` of the centre can be to the rectangle.
const function nearest(minX: number, maxX: number, minZ: number, maxZ: number, slack: number): number
	const dx = math.max(minX, -maxX, 0)
	const dz = math.max(minZ, -maxZ, 0)
	return math.max(math.sqrt(dx * dx + dz * dz) - slack, 0)
end

function Clipmap.Build(tier: any, waves: { any }, settings: any): Layout
	const grid, spacing, levels = tier.Grid, tier.Spacing, tier.Levels
	-- (Quarters an even number of quads, so a chunk's sides start on even
	-- points: the ones the next ring has too.)
	assert(grid % 8 == 0, "Clipmap: a tier's Grid must be a multiple of 8")
	const quarter = grid // 4
	-- The camera's at most a spacing off the centre either way.
	const slack = spacing * math.sqrt(2)

	const chunks: { Chunk } = {}
	for level = 0, levels - 1 do
		const step = spacing * 2 ^ level
		const half = grid * step / 2
		const coarser = level < levels - 1
		for _, piece in if level == 0 then MIDDLE_PIECES else RING_PIECES do
			const across, along = piece[1] * quarter, piece[2] * quarter
			const columns, rows = piece[3] * quarter, piece[4] * quarter
			const minX, minZ = -half + across * step, -half + along * step
			const maxX, maxZ = minX + columns * step, minZ + rows * step
			table.insert(chunks, {
				Level = level,
				Spacing = step,
				Columns = columns,
				Rows = rows,
				OriginX = minX,
				OriginZ = minZ,
				MidX = (minX + maxX) / 2,
				MidZ = (minZ + maxZ) / 2,
				HalfX = (maxX - minX) / 2,
				HalfZ = (maxZ - minZ) / 2,
				StitchLeft = coarser and across == 0,
				StitchRight = coarser and across + columns == grid,
				StitchBottom = coarser and along == 0,
				StitchTop = coarser and along + rows == grid,
				Nearest = nearest(minX, maxX, minZ, maxZ, slack),
			})
		end
	end

	-- Each wave reaches out to the edge of the coarsest level fine enough
	-- for it, less how far the camera can be off the centre.
	const fades: { Fade } = {}
	for index, wave in waves do
		local out = 0
		for level = levels - 1, 0, -1 do
			const step = spacing * 2 ^ level
			if step <= wave.Length / settings.SamplesPerWave then
				out = grid * step / 2 - spacing
				break
			end
		end
		fades[index] = { Start = out * settings.FadeStart, Out = out }
	end

	local reach, height = 0, 0
	for _, wave in waves do
		reach += wave.Steepness * wave.Amplitude
		height += wave.Amplitude
	end

	const lastHalf = grid * spacing * 2 ^ (levels - 1) / 2
	return {
		Chunks = chunks,
		Snap = 2 * spacing,
		Fades = fades,
		Skirt = {
			Points = grid,
			Rings = { lastHalf, lastHalf * 4, math.max(settings.Horizon, lastHalf * 8) },
		},
		Reach = reach,
		Height = height,
	}
end

return Clipmap
]]></ProtectedString>
				<string name="ScriptGuid">{76DFC138-DBD8-4369-90FF-3ED97F0962BF}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Clipmap</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">791632d9be0626cc0af91aa600008410</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX5862B49E2C7740EA8A6C2351D457C702">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[const runService = game:GetService("RunService")
const lighting = game:GetService("Lighting")
const soundService = game:GetService("SoundService")

const Settings = require("./OceanSettings")
const Waves = require("./Waves")

--[[
	Client only. Under the water (as KYBER's swimming has it): with the
	camera below the surface (the waves' height over it: Waves.HeightAt),
	it's blurred, tinted and closed in by the water's colour, darker and
	closer the deeper it goes, and sounds echo as under water. It all eases
	in as the camera goes under and out as it comes up (Fade), the distance
	it closes in to through its log (from far off to close at an even pace).

		Underwater.Start() -- once (Ocean.Start does)
		Underwater.Amount -- 0 above water, 1 under it (eased)

	The fog cover (FogCover, as KYBER's weather has it: a sphere round the
	camera, seen from inside, CoverSize studs across) fades in all the
	water's colour, so past it there's only water, no sky. What fades
	things on the way there suits the lighting: with no Atmosphere,
	Lighting's fog (FogColor, FogStart, FogEnd; put back after); with one
	(which switches the fog off), its haze is eased down (Haze; put back
	after) and a second, thinner cover (the veil) fades in part of the way
	out (VeilAt). Both are drawn unlit (Neon, too dark
	to glow), so they're the one colour all round. The tint and blur are
	effects of their own in Lighting (OceanUnderwater).

	With the camera over the highest the waves reach, nothing's worked out.
]]

-- How far off it closes in from as the camera goes under or comes up: about
-- as far off as the haze above water.
const SURFACE_FOG = 800

const Underwater = {
	Amount = 0,
}

local started = false
local waves: { Waves.Wave } = {}
-- The most the waves can lift the water over sea level.
local reach = 0
local tint: ColorCorrectionEffect? = nil
local blur: BlurEffect? = nil
-- The fog cover and the veil (a thinner one inside it), their meshes, and
-- the mesh's own (full) scale.
local cover: BasePart? = nil
local veil: BasePart? = nil
local coverScale = Vector3.one
-- While under: whether there's an Atmosphere (then the veil, not the
-- fog), the fog as it was, and the echo.
local airy = false
local air: Atmosphere? = nil
local dryHaze = 0
local dryFog: { Color: Color3, Start: number, End: number }? = nil
local dryReverb: Enum.ReverbType? = nil
local wetted = false

const function mix(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- A sphere `radius` studs round the camera at `eye`, its colour, and how
-- see-through.
const function place(sphere: BasePart, eye: Vector3, radius: number, color: Color3, transparency: number)
	sphere.CFrame = CFrame.new(eye)
	sphere.Color = color
	sphere.Transparency = transparency
	const full = math.abs(coverScale.Y);
	(sphere:FindFirstChildOfClass("SpecialMesh") :: SpecialMesh).Scale = coverScale * (math.min(radius * 2, full) / full)
end

-- Going under: the fog as it is kept (with no Atmosphere) or the veil in
-- (with one), and the cover.
const function wet()
	if wetted then
		return
	end
	wetted = true
	const atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
	airy = atmosphere ~= nil
	if atmosphere then
		air = atmosphere
		dryHaze = atmosphere.Haze;
		(veil :: BasePart).Parent = workspace.Terrain
	else
		dryFog = { Color = lighting.FogColor, Start = lighting.FogStart, End = lighting.FogEnd }
	end
	(cover :: BasePart).Parent = workspace.Terrain
end

-- Come up: all as it was.
const function dry()
	if not wetted then
		return
	end
	wetted = false
	const fog = dryFog
	if fog then
		lighting.FogColor = fog.Color
		lighting.FogStart = fog.Start
		lighting.FogEnd = fog.End
		dryFog = nil
	end
	if air then
		air.Haze = dryHaze
		air = nil
	end
	(cover :: BasePart).Parent = nil;
	(veil :: BasePart).Parent = nil;
	(tint :: ColorCorrectionEffect).Enabled = false;
	(blur :: BlurEffect).Enabled = false
	if dryReverb then
		soundService.AmbientReverb = dryReverb
		dryReverb = nil
	end
end

-- Everything as `amount` under water (0 to 1), the camera at `eye`,
-- `depth` studs down.
const function apply(amount: number, depth: number, eye: Vector3)
	const water = Settings.Underwater
	const deep = math.clamp(depth / water.DeepAt, 0, 1)
	const color = water.FogColor:Lerp(water.DeepFog, deep)
	const fogEnd = math.exp(mix(math.log(SURFACE_FOG), math.log(mix(water.FogEnd, water.DeepFogEnd, deep)), amount))
	const reachOut = water.CoverSize / 2

	const fog = dryFog
	if fog then
		lighting.FogColor = fog.Color:Lerp(color, amount)
		lighting.FogStart = mix(fog.Start, water.FogStart, amount)
		lighting.FogEnd = fogEnd
	end
	if airy then
		const atmosphere = air
		if atmosphere then
			atmosphere.Haze = mix(dryHaze, water.Haze, amount)
		end
		place(veil :: BasePart, eye, reachOut * water.VeilAt, color, 1 - amount * (1 - water.VeilTransparency))
	end
	place(cover :: BasePart, eye, reachOut, color, 1 - amount)

	const grade = tint :: ColorCorrectionEffect
	grade.Enabled = true
	grade.TintColor = Color3.new(1, 1, 1):Lerp(water.Tint, amount)
	grade.Contrast = water.Contrast * amount
	grade.Saturation = water.Saturation * amount
	grade.Brightness = water.Brightness * amount
	const haze = blur :: BlurEffect
	haze.Enabled = true
	haze.Size = water.Blur * amount

	const under = amount >= 0.5
	if under and not dryReverb then
		dryReverb = soundService.AmbientReverb
		soundService.AmbientReverb = Enum.ReverbType.UnderWater
	elseif not under and dryReverb then
		soundService.AmbientReverb = dryReverb
		dryReverb = nil
	end
end

const function step(deltaTime: number)
	const camera = workspace.CurrentCamera
	if not camera then
		return
	end
	const eye = camera.CFrame.Position
	local depth = -math.huge
	if eye.Y < Settings.SeaLevel + reach then
		depth = Settings.SeaLevel + Waves.HeightAt(waves, eye.X, eye.Z, workspace:GetServerTimeNow()) - eye.Y
	end
	const target = if depth > 0 then 1 else 0
	local amount = Underwater.Amount
	if amount == 0 and target == 0 then
		return
	end
	amount += (target - amount) * (1 - math.exp(-Settings.Underwater.Fade * deltaTime))
	if math.abs(target - amount) < 0.002 then
		amount = target
	end
	Underwater.Amount = amount
	if amount > 0 then
		wet()
		apply(amount, math.max(depth, 0), eye)
	else
		dry()
	end
end

-- A copy of the fog cover: only to be seen, from inside (nothing hits it,
-- it shades nothing), and unlit.
const function sphere(name: string): BasePart
	const copy = script.FogCover:Clone()
	copy.Name = name
	copy.CastShadow = false
	copy.CanCollide = false
	copy.CanQuery = false
	copy.CanTouch = false
	copy.Material = Enum.Material.Neon
	return copy
end

function Underwater.Start()
	if started then
		return
	end
	started = true
	waves = Waves.Build(Settings)
	for _, wave in waves do
		reach += wave.Amplitude
	end

	cover = sphere("FogCover")
	veil = sphere("FogVeil")
	coverScale = (script.FogCover:FindFirstChildOfClass("SpecialMesh") :: SpecialMesh).Scale

	const grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "OceanUnderwater"
	grade.Enabled = false
	grade.Parent = lighting
	tint = grade
	const haze = Instance.new("BlurEffect")
	haze.Name = "OceanUnderwater"
	haze.Size = 0
	haze.Enabled = false
	haze.Parent = lighting
	blur = haze

	runService.PreRender:Connect(step)
end

return Underwater
