		<Properties>
			<Content name="LinkedSource"><null></null></Content>
			<ProtectedString name="Source"><![CDATA[const runService = game:GetService("RunService")
const players = game:GetService("Players")
const contentProvider = game:GetService("ContentProvider")
const materialService = game:GetService("MaterialService")
const userInputService = game:GetService("UserInputService")

const Settings = require("@self/OceanSettings")
const Waves = require("@self/Waves")
const Underwater = require("@self/Underwater")

--[[
	Client only. The ocean: Gerstner swells (Waves) round the camera out to
	the horizon, the ripples on them (an animated normal map), and the look
	of being under it (Underwater).

		Ocean.Start() -- once, from ClientFocal
		Ocean.HeightAt(position) -- the water's height over a point, now
		Ocean.NormalAt(position) -- the way up from the water there

	Each player's own settings (the ocean menu: StarterGui.OceanMenu):

		Ocean.SetTier(name?) -- "VeryLow", "Low", "Medium" or "High" (nil: by
		                     -- device); the water's built again for it
		Ocean.SetRipples(on?) -- whether the ripples play (nil: as its tier has it)
		Ocean.SetMaxRate(rate?) -- the most it's moved a second (nil: the tier's)
		Ocean.Choice -- what they've chosen: Tier, Ripples, MaxRate

	The water's EditableMeshes (Clipmap's chunks) are built and moved by
	workers, copies of OceanWorker (Actors) running in parallel, each with
	its share. This keeps them in step: each tick it puts on workspace.Ocean
	(the folder their parts are in) the Time to show the waves at, where
	the clipmap's centred (CenterX, CenterZ: the camera, to Clipmap's
	snap), where the camera is (EyeX, EyeZ: what the waves fade by) and
	a count (Tick), so they know there's something new. Between ticks they
	only move chunks just come on screen, to the same moment, so all of it
	always shows one time and the chunks meet with no crack.

	It ticks at the tier's MaxRate at most; less often (not under its
	MinRate) while the workers' writes (the cost that can't be done in
	parallel) take more than its Budget a second. It ticks straight away
	when the camera's gone a snap, too, so the water keeps up with it.
	workspace.Ocean shows the Rate it's ticking at and the writes' Cost (in
	milliseconds a tick), for a look while playing.

	The parts never move: their points are put where they are on the sea,
	so the water's MaterialVariant (Organic, laid on by where the points
	are) stays put on the sea as it goes by. Its frames play by swapping
	which variant the parts use, once they've all downloaded.

	The tier (how fine the water is: OceanSettings.Tiers) is picked by the
	device and its graphics quality, unless OceanSettings.Tier says. With no
	EditableMeshes to be had, the water's flat (the ripples still play).
]]

-- Seconds between looks at what the workers' writes cost.
const ADAPT_INTERVAL = 1
-- How far the tick rate goes towards what the budget allows at each look
-- (so it settles rather than swings).
const ADAPT_EASE = 0.5
-- The flat fallback: parts this wide, this many each way of the one
-- under the camera.
const FALLBACK_SIZE = 2048
const FALLBACK_SPAN = 1

const Ocean = {
	Tier = nil :: string?,
	SeaLevel = Settings.SeaLevel,
	Waves = Waves.Build(Settings),
	Choice = {
		Tier = nil :: string?,
		Ripples = nil :: boolean?,
		MaxRate = nil :: number?,
	},
}

local started = false
local root: Folder? = nil
local tier: any = nil
const workers: { Actor } = {}
-- Every part of the water, and the frame of the ripples they're showing
-- (only the first till they've all downloaded).
const parts: { BasePart } = {}
local frameName = ""
local framesReady = false
local preloading = false

-- Ticks: how many a second now, when the last was, how many so far, and
-- where the clipmap was centred for it. How long since the costs were
-- last looked at.
local rate = 0
local lastTick = -math.huge
local tickCount = 0
local centerX, centerZ = math.huge, math.huge
local adaptAge = 0

-- The flat water, if it's come to that, and the spot it's round.
local fallbackParts: { BasePart }? = nil
local fallbackX, fallbackZ = math.huge, math.huge

-- VeryLow with the graphics turned right down; Low on phones and tablets
-- (unless their graphics are turned well up) and at low graphics quality;
-- High only with them turned well up.
const function pickTier(): string
	if Settings.Tier then
		return Settings.Tier
	end
	const quality = UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value
	const handheld = userInputService.TouchEnabled and not userInputService.KeyboardEnabled
	if quality >= 8 then
		return if handheld then "Medium" else "High"
	elseif quality >= 1 and quality <= 2 then
		return "VeryLow"
	elseif handheld or quality == 3 then
		return "Low"
	end
	return "Medium"
end

-- Whether the ripples play: as the player's said, or else as the tier has
-- it (they do unless it says not).
const function ripplesOn(): boolean
	const chosen = Ocean.Choice.Ripples
	if chosen ~= nil then
		return chosen
	end
	return tier == nil or tier.Ripples ~= false
end

const function frameAt(now: number): string
	const frames = Settings.Frames
	if not framesReady or not ripplesOn() then
		return string.format(frames.Name, 0)
	end
	return string.format(frames.Name, math.floor(now * frames.Rate) % frames.Count)
end

-- Every frame's textures downloaded before any plays, so none shows up
-- blank its first time round.
const function preload()
	const frames = Settings.Frames
	const folder = materialService:WaitForChild(frames.Folder, 30)
	if not folder then
		warn(`Ocean: no MaterialService.{frames.Folder}, so the ripples won't play`)
		return
	end
	const variants = {}
	for frame = 0, frames.Count - 1 do
		const variant = folder:FindFirstChild(string.format(frames.Name, frame))
		if variant then
			table.insert(variants, variant)
		end
	end
	if #variants < frames.Count then
		warn(`Ocean: only {#variants} of the {frames.Count} ripple frames are there, so they won't play`)
		return
	end
	contentProvider:PreloadAsync(variants)
	framesReady = true
end

-- The frames downloaded once the ripples first play (not before: on the
-- tiers that have them still, nothing's spent on them unless wanted).
const function wantFrames()
	if ripplesOn() and not preloading then
		preloading = true
		task.spawn(preload)
	end
end

const function track(child: Instance)
	if child:IsA("BasePart") then
		table.insert(parts, child)
		child.MaterialVariant = frameName
	end
end

const function forget(child: Instance)
	const at = table.find(parts, child :: BasePart)
	if at then
		table.remove(parts, at)
	end
end

-- A tick: the moment and place for the workers to put the water at.
const function publish(now: number, x: number, z: number, eye: Vector3)
	const folder = root :: Folder
	lastTick = now
	centerX, centerZ = x, z
	tickCount += 1
	folder:SetAttribute("Time", now)
	folder:SetAttribute("CenterX", x)
	folder:SetAttribute("CenterZ", z)
	folder:SetAttribute("EyeX", eye.X)
	folder:SetAttribute("EyeZ", eye.Z)
	folder:SetAttribute("Tick", tickCount)
end

-- The most it's moved a second: the tier's, or less if the player's said.
const function topRate(): number
	return math.min(tier.MaxRate, Ocean.Choice.MaxRate or math.huge)
end

-- The water built for the tier chosen (or the device's): a first tick
-- (the sea the workers build to), then the workers.
const function build()
	const tierName = Ocean.Choice.Tier or pickTier()
	tier = Settings.Tiers[tierName]
	assert(tier, `Ocean: no tier "{tierName}" in OceanSettings.Tiers`)
	Ocean.Tier = tierName
	rate = topRate()
	const folder = root :: Folder
	folder:SetAttribute("Tier", tierName)
	const camera = workspace.CurrentCamera
	const eye = if camera then camera.CFrame.Position else Vector3.zero
	const snap = 2 * tier.Spacing
	publish(workspace:GetServerTimeNow(), math.round(eye.X / snap) * snap, math.round(eye.Z / snap) * snap, eye)

	const playerScripts = players.LocalPlayer:WaitForChild("PlayerScripts")
	for index = 0, tier.Workers - 1 do
		const worker = script.OceanWorker:Clone()
		worker:SetAttribute("Index", index)
		worker:SetAttribute("Count", tier.Workers)
		worker.Parent = playerScripts
		table.insert(workers, worker)
	end
end

-- The water taken away: its workers, and every part of it.
const function tearDown()
	for _, worker in workers do
		worker:Destroy()
	end
	table.clear(workers)
	fallbackParts = nil
	fallbackX, fallbackZ = math.huge, math.huge
	adaptAge = 0;
	(root :: Folder):ClearAllChildren()
end

-- No EditableMeshes on this device (or none to spare): the workers and
-- their water gone, flat water round the camera instead.
const function fallBack()
	warn("Ocean: no EditableMeshes to be had, so the water's flat")
	tearDown()
	const folder = root :: Folder
	const flat = {}
	for _ = 1, (2 * FALLBACK_SPAN + 1) ^ 2 do
		const part = Instance.new("Part")
		part.Name = "Flat"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Size = Vector3.new(FALLBACK_SIZE, 1, FALLBACK_SIZE)
		part.Material = Settings.Material
		part.Color = Settings.Colors.Body
		part.Parent = folder
		table.insert(flat, part)
	end
	fallbackParts = flat
end

-- The flat water round the part under the camera.
const function moveFallback(eye: Vector3)
	const x = math.round(eye.X / FALLBACK_SIZE) * FALLBACK_SIZE
	const z = math.round(eye.Z / FALLBACK_SIZE) * FALLBACK_SIZE
	if x == fallbackX and z == fallbackZ then
		return
	end
	fallbackX, fallbackZ = x, z
	const flat = fallbackParts :: { BasePart }
	local k = 0
	for i = -FALLBACK_SPAN, FALLBACK_SPAN do
		for j = -FALLBACK_SPAN, FALLBACK_SPAN do
			k += 1
			flat[k].Position = Vector3.new(x + i * FALLBACK_SIZE, Settings.SeaLevel - 0.5, z + j * FALLBACK_SIZE)
		end
	end
end

-- How dear the workers' writes are a tick, so how often it can tick
-- within the tier's budget; and whether any couldn't build.
const function adapt(deltaTime: number)
	adaptAge += deltaTime
	if adaptAge < ADAPT_INTERVAL then
		return
	end
	adaptAge = 0
	local cost = 0
	for _, worker in workers do
		if worker:GetAttribute("Failed") == true then
			fallBack()
			return
		end
		const spent = worker:GetAttribute("Cost")
		if type(spent) == "number" then
			cost += spent
		end
	end
	const top = topRate()
	const affordable = if cost > 0 then tier.Budget / cost else top
	rate += (math.clamp(affordable, math.min(tier.MinRate, top), top) - rate) * ADAPT_EASE
	const folder = root :: Folder
	folder:SetAttribute("Rate", math.round(rate))
	folder:SetAttribute("Cost", math.round(cost * 100) / 100)
end

const function step(deltaTime: number)
	const camera = workspace.CurrentCamera
	if not camera or not root then
		return
	end
	const now = workspace:GetServerTimeNow()
	const eye = camera.CFrame.Position

	if fallbackParts then
		moveFallback(eye)
	else
		const snap = 2 * tier.Spacing
		const x = math.round(eye.X / snap) * snap
		const z = math.round(eye.Z / snap) * snap
		if now - lastTick >= 1 / rate or x ~= centerX or z ~= centerZ then
			publish(now, x, z, eye)
		end
		adapt(deltaTime)
	end

	const name = frameAt(now)
	if name ~= frameName then
		frameName = name
		for _, part in parts do
			part.MaterialVariant = name
		end
	end
end

function Ocean.Start()
	if started then
		return
	end
	started = true
	const folder = Instance.new("Folder")
	folder.Name = "Ocean"
	root = folder
	frameName = string.format(Settings.Frames.Name, 0)
	folder.ChildAdded:Connect(track)
	folder.ChildRemoved:Connect(forget)
	folder.Parent = workspace
	build()

	wantFrames()
	runService.PreRender:Connect(step)
	Underwater.Start()
end

-- A tier for this player (nil: by device), the water built again for it
-- if it's not the one it has.
function Ocean.SetTier(name: string?)
	assert(name == nil or Settings.Tiers[name], `Ocean: no tier "{name}" in OceanSettings.Tiers`)
	Ocean.Choice.Tier = name
	if started and (name or pickTier()) ~= Ocean.Tier then
		tearDown()
		build()
		wantFrames()
	end
end

-- Whether the ripples play (off: they stand still; nil: as the tier has
-- it).
function Ocean.SetRipples(on: boolean?)
	Ocean.Choice.Ripples = on
	if started then
		wantFrames()
	end
end

-- The most the water's moved a second (nil: its tier's own).
function Ocean.SetMaxRate(maxRate: number?)
	Ocean.Choice.MaxRate = maxRate
	if tier then
		rate = topRate()
	end
end

-- The water's height over `position` now: every wave, in full.
function Ocean.HeightAt(position: Vector3): number
	return Settings.SeaLevel + Waves.HeightAt(Ocean.Waves, position.X, position.Z, workspace:GetServerTimeNow())
end

function Ocean.NormalAt(position: Vector3): Vector3
	return Waves.NormalAt(Ocean.Waves, position.X, position.Z, workspace:GetServerTimeNow())
end

return Ocean]]></ProtectedString>
