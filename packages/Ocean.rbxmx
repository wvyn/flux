			<Item class="LocalScript" referent="RBX47B93A1F62F94980945485E090805FD5">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!native
--!optimize 2
const runService = game:GetService("RunService")
const assetService = game:GetService("AssetService")
const replicatedStorage = game:GetService("ReplicatedStorage")

const oceanModule = replicatedStorage:WaitForChild("Modules"):WaitForChild("Ocean")
const Settings = require(oceanModule:WaitForChild("OceanSettings"))
const Waves = require(oceanModule:WaitForChild("Waves"))
const Clipmap = require(oceanModule:WaitForChild("Clipmap"))

--[[
	One of the ocean's workers (Ocean starts a few: copies of this Actor,
	each told its Index and the Count of them). It builds its share of the
	clipmap's chunks (every Count-th from its Index; the first has the flat
	skirt too), each an EditableMesh on a MeshPart of its own in
	workspace.Ocean, and keeps them moving with the waves.

	Every frame, in parallel with the others: if Ocean's ticked (a new Tick
	on workspace.Ocean), each of its chunks on screen is worked out for the
	tick's time; if not, only those come on screen since they were last
	moved, to the same time. Back in step (the writes can't be done in
	parallel), their points are set. Off screen, a chunk's left as it was,
	but for one every REFRESH_TICKS ticks (the longest out of date), so
	none's far behind when the camera swings round to it.

	Working a point out is cheap: each wave's turn at the centre is worked
	out once a chunk (a sine and a cosine), and its turn at a point from
	that and the point's own (worked out when it's built: its place from
	the centre never changes) by the sum of angles. No sines a point.

	A chunk's inside points get their normals from the mesh (the engine
	works them out from the faces round them); its edge points have theirs
	set, from the waves, so the next chunk's match and no seam shows.
	Chunks with no waves to show (the skirt, and any ring too coarse for
	them all) are only moved when the centre is.

	Each point's coloured by its lift (OceanSettings.Colors: deep in the
	troughs, bright on the crests, foam where the waves bunch the water
	up), rounded to one of a few shades: its colour's only written when its
	shade changes, which for most points isn't every tick.

	Each chunk has an underside too (for the view from under water): faces
	the other way round on the same points, all lit as if facing up, so it
	costs nothing more to move.

	A device can only have a few EditableMeshes being built at once (each
	keeps room to grow), so a chunk's built in a scratch mesh (waiting its
	turn for one if need be), copied into one just its size (FixedSize: no
	more's ever added to it), which there's room for plenty of, and the
	scratch let go straight away.

	Each second it puts its Cost on its Actor (milliseconds its writes took
	a tick): Ocean ticks less often while they're too dear. If it can't
	build (no EditableMeshes to be had), it says why in the output and
	marks itself Failed.
]]

-- A chunk still counts as on screen this far past its edges (the view's
-- half-angles, times this).
const VIEW_SLACK = 1.15
-- Seconds between reports of its Cost.
const REPORT_INTERVAL = 1
-- Ticks between refreshes of an off-screen chunk.
const REFRESH_TICKS = 3
-- Tries for a scratch mesh this many times, this many seconds apart,
-- before it gives up.
const SCRATCH_TRIES = 40
const SCRATCH_WAIT = 0.25
-- How far up the water's shades (0 deepest, 1 highest, a half at rest) a
-- crest is all Crest; above it, the foam's.
const CREST_AT = 0.8

const actor = script:GetActor() :: Actor
const root = workspace:WaitForChild("Ocean")
const index = actor:GetAttribute("Index") :: number
const count = actor:GetAttribute("Count") :: number
const tier = Settings.Tiers[root:GetAttribute("Tier") :: string]

const waves = Waves.Build(Settings)
const layout = Clipmap.Build(tier, waves, Settings)
const seaLevel = Settings.SeaLevel
const reach = layout.Reach
const height = layout.Height

-- Each wave's numbers, laid out flat for the loops below: its way, its
-- radians a stud and a second, where it starts, how high it lifts the
-- water and how far along it carries it (and that over its height), and
-- where it's faded out (and one over how far it takes to).
const waveCount = #waves
const directionX = table.create(waveCount, 0)
const directionZ = table.create(waveCount, 0)
const waveNumber = table.create(waveCount, 0)
const waveSpeed = table.create(waveCount, 0)
const wavePhase = table.create(waveCount, 0)
const amplitude = table.create(waveCount, 0)
const carry = table.create(waveCount, 0)
const steepness = table.create(waveCount, 0)
const fadeOut = table.create(waveCount, 0)
const fadeScale = table.create(waveCount, 0)
for w, wave in waves do
	directionX[w] = wave.DirectionX
	directionZ[w] = wave.DirectionZ
	waveNumber[w] = wave.Number
	waveSpeed[w] = wave.Speed
	wavePhase[w] = wave.Phase
	amplitude[w] = wave.Amplitude
	carry[w] = wave.Steepness * wave.Amplitude
	steepness[w] = wave.Steepness
	const fade = layout.Fades[w]
	fadeOut[w] = fade.Out
	fadeScale[w] = if fade.Out > fade.Start then 1 / (fade.Out - fade.Start) else 0
end

-- The water's shades, deepest to highest (OceanSettings.Colors): Deep at
-- the bottom, Body at rest, Crest at CREST_AT, Foam at the top.
const colors = Settings.Colors
const shadeCount = Settings.ColorShades
const palette: { Color3 } = table.create(shadeCount + 1)
for shade = 0, shadeCount do
	const t = shade / shadeCount
	palette[shade + 1] = if t <= 0.5 then colors.Deep:Lerp(colors.Body, t * 2)
		elseif t <= CREST_AT then colors.Body:Lerp(colors.Crest, (t - 0.5) / (CREST_AT - 0.5))
		else colors.Crest:Lerp(colors.Foam, (t - CREST_AT) / (1 - CREST_AT))
end
-- The shade at rest (every point's built with it), and how far up the
-- shades a point goes for each stud it's sunk or lifted, and for each bit
-- its crest bunches the water up past FoamFrom.
const restShade = shadeCount // 2
const sinkShade = 0.5 / Settings.ColorDepth
const liftShade = (CREST_AT - 0.5) / Settings.ColorHeight
const foamFrom = Settings.FoamFrom
const foamShade = (1 - CREST_AT) / (Settings.FoamFull - Settings.FoamFrom)

type Chunk = {
	Part: MeshPart,
	Mesh: EditableMesh,
	-- Its middle's place from the centre, and how far it reaches either
	-- way; on screen whatever (the skirt, all round the camera); no waves.
	MidX: number,
	MidZ: number,
	HalfX: number,
	HalfZ: number,
	Always: boolean,
	Still: boolean,
	-- Its points: each one's place from the centre, and its vertex.
	Points: number,
	OffsetX: { number },
	OffsetZ: { number },
	Vertex: { number },
	-- Each point's slot among its edge points (0 inside), and each slot's
	-- normal.
	EdgeSlot: { number },
	EdgeNormal: { number },
	-- Odd points along a stitched side, and the two either side of each.
	Stitch: { number },
	StitchA: { number },
	StitchB: { number },
	-- The waves it shows, and each one's turn at each of its points from
	-- the centre (point by point, wave by wave).
	Active: { number },
	SinB: { number },
	CosB: { number },
	-- Worked out this frame: each point's place, each edge slot's normal.
	X: { number },
	Y: { number },
	Z: { number },
	NX: { number },
	NY: { number },
	NZ: { number },
	-- Each point's colour, the shade it's showing, and this frame's: how
	-- far up the shades it is and the shade that rounds to; the points
	-- whose shade has changed (Recolors of them).
	Color: { number },
	Shade: { number },
	Lift: { number },
	Next: { number },
	Recolor: { number },
	Recolors: number,
	-- What it was last moved for.
	Tick: number,
	CenterX: number,
	CenterZ: number,
}

const chunks: { Chunk } = {}
-- Chunks moved this frame, to be written once back in step.
const pending: { Chunk } = {}
-- Each wave's turn at the centre, for the chunk being worked out.
const turnSin = table.create(waveCount, 0)
const turnCos = table.create(waveCount, 0)
-- The view: the camera's place, and its four sides' inward normals.
local eyeX, eyeY, eyeZ = 0, 0, 0
const sideX = table.create(4, 0)
const sideY = table.create(4, 0)
const sideZ = table.create(4, 0)

const function makePart(mesh: EditableMesh, name: string): MeshPart
	const part = assetService:CreateMeshPartAsync(Content.fromObject(mesh), {
		CollisionFidelity = Enum.CollisionFidelity.Box,
		RenderFidelity = Enum.RenderFidelity.Precise,
	})
	part.Name = name
	part.Anchored = true
	-- (Only to be seen: nothing bumps into it, hits it or casts on it.)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Settings.Material
	-- (White: its points' colours are the water's.)
	part.Color = Color3.new(1, 1, 1)
	-- It never moves: its points are put where they are on the sea.
	part.CFrame = CFrame.new(0, seaLevel, 0)
	return part
end

-- A mesh to build a chunk in (see the top): it may have to wait for
-- another worker to finish with one.
const function scratchMesh(): EditableMesh
	for _ = 1, SCRATCH_TRIES do
		const mesh = assetService:CreateEditableMesh()
		if mesh then
			return mesh
		end
		task.wait(SCRATCH_WAIT)
	end
	error("no EditableMesh to build in", 0)
end

-- The scratch's chunk copied into a mesh just its size, and the scratch
-- let go. Each point's vertex, normal and colour in the copy: the point
-- found by `pointAt` from where it was built (a copy needn't keep ids),
-- its normal the one that isn't the underside's (which every point has).
const function settle(scratch: EditableMesh, points: number, pointAt: (Vector3) -> number): (EditableMesh, { number }, { number }, { number })
	const copied, result = pcall(function()
		return assetService:CreateEditableMeshAsync(Content.fromObject(scratch), { FixedSize = true })
	end)
	scratch:Destroy()
	if not copied then
		error(result, 0)
	end
	const mesh = result :: EditableMesh
	const vertex = table.create(points, 0)
	const normal = table.create(points, 0)
	const color = table.create(points, 0)
	const ids = mesh:GetVertices()
	const second = mesh:GetVertexNormals(ids[2])
	local under: number? = nil
	for _, id in mesh:GetVertexNormals(ids[1]) do
		if table.find(second, id) then
			under = id
			break
		end
	end
	for _, id in ids do
		const point = pointAt(mesh:GetPosition(id))
		vertex[point] = id
		for _, normalId in mesh:GetVertexNormals(id) do
			if normalId ~= under then
				normal[point] = normalId
				break
			end
		end
		color[point] = mesh:GetVertexColors(id)[1]
	end
	return mesh, vertex, normal, color
end

-- The chunk's waves' turns at each of its points, from the centre.
const function prepare(chunk: Chunk)
	const active = chunk.Active
	const span = #active
	const sinB = table.create(chunk.Points * span, 0)
	const cosB = table.create(chunk.Points * span, 0)
	for v = 1, chunk.Points do
		const ox, oz = chunk.OffsetX[v], chunk.OffsetZ[v]
		const base = (v - 1) * span
		for j = 1, span do
			const w = active[j]
			const turn = waveNumber[w] * (directionX[w] * ox + directionZ[w] * oz)
			sinB[base + j] = math.sin(turn)
			cosB[base + j] = math.cos(turn)
		end
	end
	chunk.SinB, chunk.CosB = sinB, cosB
end

const function buildGrid(info: Clipmap.Chunk): Chunk
	const columns, rows, step = info.Columns, info.Rows, info.Spacing
	const across = columns + 1
	const points = across * (rows + 1)
	const scratch = scratchMesh()
	const under = scratch:AddNormal(Vector3.yAxis)
	const scratchVertex = table.create(points, 0)
	const scratchNormal = table.create(points, 0)
	const scratchColor = table.create(points, 0)
	const offsetX = table.create(points, 0)
	const offsetZ = table.create(points, 0)
	const onEdge = table.create(points, false)
	local v = 0
	for j = 0, rows do
		for i = 0, columns do
			v += 1
			offsetX[v], offsetZ[v] = info.OriginX + i * step, info.OriginZ + j * step
			onEdge[v] = i == 0 or i == columns or j == 0 or j == rows
			-- (Built a stud apart round its own middle, a hair up and down:
			-- where a point is says which it is, and the part comes out its
			-- true size. It's put where it goes before it's shown.)
			scratchVertex[v] = scratch:AddVertex(Vector3.new(i - columns / 2, if (i + j) % 2 == 0 then 0.25 else -0.25, j - rows / 2))
			scratchNormal[v] = if onEdge[v] then scratch:AddNormal(Vector3.yAxis) else scratch:AddNormal()
			scratchColor[v] = scratch:AddColor(colors.Body, 1)
		end
	end

	-- A face, and its underside.
	const function face(a: number, b: number, c: number)
		const id = scratch:AddTriangle(scratchVertex[a], scratchVertex[b], scratchVertex[c])
		scratch:SetFaceNormals(id, { scratchNormal[a], scratchNormal[b], scratchNormal[c] })
		scratch:SetFaceColors(id, { scratchColor[a], scratchColor[b], scratchColor[c] })
		const below = scratch:AddTriangle(scratchVertex[a], scratchVertex[c], scratchVertex[b])
		scratch:SetFaceNormals(below, { under, under, under })
		scratch:SetFaceColors(below, { scratchColor[a], scratchColor[c], scratchColor[b] })
	end
	for j = 0, rows - 1 do
		for i = 0, columns - 1 do
			const a = j * across + i + 1
			const b, c = a + 1, a + across
			const d = c + 1
			-- (The diagonals alternate, so the triangles lean no one way.)
			if (i + j) % 2 == 0 then
				face(a, c, b)
				face(b, c, d)
			else
				face(a, c, d)
				face(a, d, b)
			end
		end
	end

	const mesh, vertex, normalOf, colorOf = settle(scratch, points, function(position: Vector3): number
		return math.round(position.Z + rows / 2) * across + math.round(position.X + columns / 2) + 1
	end)
	const edgeSlot = table.create(points, 0)
	const edgeNormal: { number } = {}
	for point = 1, points do
		if onEdge[point] then
			table.insert(edgeNormal, normalOf[point])
			edgeSlot[point] = #edgeNormal
		else
			-- (Worked out by the engine from the faces round it, as the
			-- points move.)
			mesh:ResetNormal(normalOf[point])
		end
	end

	-- Along a side next to a coarser ring: its odd points (first + step,
	-- + 3 steps, ...) and the two either side of each.
	const stitch, stitchA, stitchB = {}, {}, {}
	const function stitchSide(first: number, stride: number, length: number)
		for k = 1, length - 1, 2 do
			const point = first + k * stride
			table.insert(stitch, point)
			table.insert(stitchA, point - stride)
			table.insert(stitchB, point + stride)
		end
	end
	if info.StitchBottom then
		stitchSide(1, 1, columns)
	end
	if info.StitchTop then
		stitchSide(rows * across + 1, 1, columns)
	end
	if info.StitchLeft then
		stitchSide(1, across, rows)
	end
	if info.StitchRight then
		stitchSide(across, across, rows)
	end

	const active = {}
	for w = 1, waveCount do
		if fadeOut[w] > info.Nearest then
			table.insert(active, w)
		end
	end

	const chunk: Chunk = {
		Part = makePart(mesh, `Level{info.Level}`),
		Mesh = mesh,
		MidX = info.MidX,
		MidZ = info.MidZ,
		HalfX = info.HalfX,
		HalfZ = info.HalfZ,
		Always = false,
		Still = #active == 0,
		Points = points,
		OffsetX = offsetX,
		OffsetZ = offsetZ,
		Vertex = vertex,
		EdgeSlot = edgeSlot,
		EdgeNormal = edgeNormal,
		Stitch = stitch,
		StitchA = stitchA,
		StitchB = stitchB,
		Active = active,
		SinB = {},
		CosB = {},
		X = table.create(points, 0),
		Y = table.create(points, 0),
		Z = table.create(points, 0),
		NX = table.create(#edgeNormal, 0),
		NY = table.create(#edgeNormal, 1),
		NZ = table.create(#edgeNormal, 0),
		Color = colorOf,
		Shade = table.create(points, restShade),
		Lift = table.create(points, 0.5),
		Next = table.create(points, restShade),
		Recolor = table.create(points, 0),
		Recolors = 0,
		Tick = -1,
		CenterX = math.huge,
		CenterZ = math.huge,
	}
	prepare(chunk)
	return chunk
end

-- The flat water past the last level: squares (Clipmap's Skirt.Rings)
-- round the centre, the same number of points to each side, joined ring
-- to ring.
const function buildSkirt(): Chunk
	const rings = layout.Skirt.Rings
	const perSide = layout.Skirt.Points
	const around = 4 * perSide
	const points = #rings * around
	const scratch = scratchMesh()
	const up = scratch:AddNormal(Vector3.yAxis)
	const under = scratch:AddNormal(Vector3.yAxis)
	const tone = scratch:AddColor(colors.Body, 1)
	const offsetX = table.create(points, 0)
	const offsetZ = table.create(points, 0)
	const scratchVertex = table.create(points, 0)
	local v = 0
	for ring, half in rings do
		-- Round from its -x, -z corner: along its -z side, then its +x, +z
		-- and -x sides.
		for p = 0, around - 1 do
			v += 1
			const side, k = p // perSide, p % perSide
			const along = -half + 2 * half * k / perSide
			local ox, oz = -half, -along
			if side == 0 then
				ox, oz = along, -half
			elseif side == 1 then
				ox, oz = half, along
			elseif side == 2 then
				ox, oz = -along, half
			end
			offsetX[v], offsetZ[v] = ox, oz
			-- (Built a stud apart, round the middle: which point it is, and
			-- no bigger than a part can be.)
			scratchVertex[v] = scratch:AddVertex(Vector3.new(p - (around - 1) / 2, if p % 2 == 0 then 0.25 else -0.25, ring - (#rings + 1) / 2))
		end
	end
	for ring = 1, #rings - 1 do
		for p = 0, around - 1 do
			const a = (ring - 1) * around + p + 1
			const b = (ring - 1) * around + (p + 1) % around + 1
			const c, d = a + around, b + around
			-- (Each with its underside: the same points the other way round.)
			for _, triangle in { { a, b, c, up }, { b, d, c, up }, { a, c, b, under }, { b, c, d, under } } do
				const id = scratch:AddTriangle(scratchVertex[triangle[1]], scratchVertex[triangle[2]], scratchVertex[triangle[3]])
				const normal = triangle[4]
				scratch:SetFaceNormals(id, { normal, normal, normal })
				scratch:SetFaceColors(id, { tone, tone, tone })
			end
		end
	end
	const mesh, vertex, _, colorOf = settle(scratch, points, function(position: Vector3): number
		return (math.round(position.Z + (#rings + 1) / 2) - 1) * around + math.round(position.X + (around - 1) / 2) + 1
	end)

	return {
		Part = makePart(mesh, "Skirt"),
		Mesh = mesh,
		MidX = 0,
		MidZ = 0,
		HalfX = rings[#rings],
		HalfZ = rings[#rings],
		Always = true,
		Still = true,
		Points = points,
		OffsetX = offsetX,
		OffsetZ = offsetZ,
		Vertex = vertex,
		EdgeSlot = table.create(points, 0),
		EdgeNormal = {},
		Stitch = {},
		StitchA = {},
		StitchB = {},
		Active = {},
		SinB = {},
		CosB = {},
		X = table.create(points, 0),
		Y = table.create(points, 0),
		Z = table.create(points, 0),
		NX = {},
		NY = {},
		NZ = {},
		Color = colorOf,
		Shade = table.create(points, restShade),
		Lift = table.create(points, 0.5),
		Next = table.create(points, restShade),
		Recolor = table.create(points, 0),
		Recolors = 0,
		Tick = -1,
		CenterX = math.huge,
		CenterZ = math.huge,
	}
end

-- Where `chunk`'s points are at `time` (the centre at cx, cz; each wave
-- faded by how far the point is from fadeX, fadeZ), its edge points'
-- normals, and which points' shades have changed.
const function solve(chunk: Chunk, time: number, cx: number, cz: number, fadeX: number, fadeZ: number)
	const active = chunk.Active
	const span = #active
	for j = 1, span do
		const w = active[j]
		const turn = waveNumber[w] * (directionX[w] * cx + directionZ[w] * cz) - waveSpeed[w] * time + wavePhase[w]
		turnSin[j] = math.sin(turn)
		turnCos[j] = math.cos(turn)
	end

	const offsetX, offsetZ = chunk.OffsetX, chunk.OffsetZ
	const sinB, cosB = chunk.SinB, chunk.CosB
	const edgeSlot = chunk.EdgeSlot
	const outX, outY, outZ = chunk.X, chunk.Y, chunk.Z
	const normalX, normalY, normalZ = chunk.NX, chunk.NY, chunk.NZ
	const lifted = chunk.Lift
	for v = 1, chunk.Points do
		const x = cx + offsetX[v]
		const z = cz + offsetZ[v]
		const awayX, awayZ = x - fadeX, z - fadeZ
		const distance = math.sqrt(awayX * awayX + awayZ * awayZ)
		const slot = edgeSlot[v]
		const base = (v - 1) * span
		local dx, dy, dz = 0, 0, 0
		local gx, gy, gz = 0, 0, 0
		for j = 1, span do
			const w = active[j]
			local fade = (fadeOut[w] - distance) * fadeScale[w]
			if fade > 0 then
				if fade > 1 then
					fade = 1
				end
				-- sin and cos of (its turn at the centre + at the point).
				const sb, cb = sinB[base + j], cosB[base + j]
				const s = turnSin[j] * cb + turnCos[j] * sb
				const c = turnCos[j] * cb - turnSin[j] * sb
				const lift = amplitude[w] * fade
				const along = carry[w] * fade * c
				dx += directionX[w] * along
				dy += lift * s
				dz += directionZ[w] * along
				-- (How much it bunches the water up here, for the foam, and
				-- tilts it, for an edge point's normal.)
				const tilt = waveNumber[w] * lift
				gy += steepness[w] * tilt * s
				if slot > 0 then
					gx += directionX[w] * tilt * c
					gz += directionZ[w] * tilt * c
				end
			end
		end
		outX[v] = x + dx
		outY[v] = dy
		outZ[v] = z + dz
		-- Its shade: down to Deep as it sinks, up to Crest as it's lifted,
		-- and on towards Foam the more its crest bunches the water up.
		local shade = if dy < 0 then math.max(0.5 + dy * sinkShade, 0) else math.min(0.5 + dy * liftShade, CREST_AT)
		if gy > foamFrom then
			shade += math.min((gy - foamFrom) * foamShade, 1 - CREST_AT)
		end
		lifted[v] = shade
		if slot > 0 then
			const nx, ny, nz = -gx, 1 - gy, -gz
			const length = math.sqrt(nx * nx + ny * ny + nz * nz)
			normalX[slot] = nx / length
			normalY[slot] = ny / length
			normalZ[slot] = nz / length
		end
	end

	-- Odd points on a stitched side: on the line between their neighbours
	-- (as the coarser ring's edge is), their normal between theirs.
	const stitch, stitchA, stitchB = chunk.Stitch, chunk.StitchA, chunk.StitchB
	for k = 1, #stitch do
		const v, a, b = stitch[k], stitchA[k], stitchB[k]
		outX[v] = (outX[a] + outX[b]) / 2
		outY[v] = (outY[a] + outY[b]) / 2
		outZ[v] = (outZ[a] + outZ[b]) / 2
		lifted[v] = (lifted[a] + lifted[b]) / 2
		const slot, slotA, slotB = edgeSlot[v], edgeSlot[a], edgeSlot[b]
		const nx = normalX[slotA] + normalX[slotB]
		const ny = normalY[slotA] + normalY[slotB]
		const nz = normalZ[slotA] + normalZ[slotB]
		const length = math.sqrt(nx * nx + ny * ny + nz * nz)
		normalX[slot] = nx / length
		normalY[slot] = ny / length
		normalZ[slot] = nz / length
	end

	-- The points whose shade has changed, to be recoloured.
	const shown, nextShade, recolor = chunk.Shade, chunk.Next, chunk.Recolor
	local recolors = 0
	for v = 1, chunk.Points do
		const shade = math.floor(lifted[v] * shadeCount + 0.5)
		if shade ~= shown[v] then
			recolors += 1
			recolor[recolors] = v
			nextShade[v] = shade
		end
	end
	chunk.Recolors = recolors
end

-- Puts `chunk`'s points (and its edge normals, and the colours of those
-- whose shade's changed) where solve worked them out. (Relative to its
-- part, at sea level over the world's middle.)
const function write(chunk: Chunk)
	const mesh = chunk.Mesh
	const vertex = chunk.Vertex
	const x, y, z = chunk.X, chunk.Y, chunk.Z
	for v = 1, chunk.Points do
		mesh:SetPosition(vertex[v], Vector3.new(x[v], y[v], z[v]))
	end
	const normal = chunk.EdgeNormal
	const nx, ny, nz = chunk.NX, chunk.NY, chunk.NZ
	for slot = 1, #normal do
		mesh:SetNormal(normal[slot], Vector3.new(nx[slot], ny[slot], nz[slot]))
	end
	const colorId, shown, nextShade, recolor = chunk.Color, chunk.Shade, chunk.Next, chunk.Recolor
	for k = 1, chunk.Recolors do
		const v = recolor[k]
		const shade = nextShade[v]
		mesh:SetColor(colorId[v], palette[shade + 1])
		shown[v] = shade
	end
	chunk.Recolors = 0
end

-- The camera's place and its view's four sides, for inView.
const function updateView(camera: Camera)
	const frame = camera.CFrame
	const position = frame.Position
	eyeX, eyeY, eyeZ = position.X, position.Y, position.Z
	const size = camera.ViewportSize
	const halfY = math.min(math.rad(camera.FieldOfView) / 2 * VIEW_SLACK, math.rad(89))
	const halfX = math.atan(math.tan(halfY) * size.X / math.max(size.Y, 1))
	const right, up, look = frame.RightVector, frame.UpVector, frame.LookVector
	const sides = {
		right * math.cos(halfX) + look * math.sin(halfX),
		-right * math.cos(halfX) + look * math.sin(halfX),
		up * math.cos(halfY) + look * math.sin(halfY),
		-up * math.cos(halfY) + look * math.sin(halfY),
	}
	for k, side in sides do
		sideX[k], sideY[k], sideZ[k] = side.X, side.Y, side.Z
	end
end

-- Whether any of `chunk` (as far as the waves can carry it) is in view.
const function inView(chunk: Chunk, cx: number, cz: number): boolean
	if chunk.Always then
		return true
	end
	const px = cx + chunk.MidX - eyeX
	const py = seaLevel - eyeY
	const pz = cz + chunk.MidZ - eyeZ
	const ex, ez = chunk.HalfX + reach, chunk.HalfZ + reach
	for k = 1, 4 do
		const nx, ny, nz = sideX[k], sideY[k], sideZ[k]
		if nx * px + ny * py + nz * pz + math.abs(nx) * ex + math.abs(ny) * height + math.abs(nz) * ez < 0 then
			return false
		end
	end
	return true
end

-- This worker's share: every count-th chunk from its index (round the
-- rings, so its share's spread all round), and the first has the skirt.
const function build()
	for number, info in layout.Chunks do
		if (number - 1) % count == index then
			table.insert(chunks, buildGrid(info))
		end
	end
	if index == 0 then
		table.insert(chunks, buildSkirt())
	end
end

const built, problem = pcall(build)
if not built then
	warn(`Ocean: a worker couldn't build its water: {problem}`)
	actor:SetAttribute("Failed", true)
	for _, chunk in chunks do
		chunk.Part:Destroy()
		chunk.Mesh:Destroy()
	end
	return
end

-- Each put where the sea is now, then shown.
do
	const tick = root:GetAttribute("Tick") :: number
	const time = root:GetAttribute("Time") :: number
	const cx, cz = root:GetAttribute("CenterX") :: number, root:GetAttribute("CenterZ") :: number
	const fadeX, fadeZ = root:GetAttribute("EyeX") :: number, root:GetAttribute("EyeZ") :: number
	for _, chunk in chunks do
		solve(chunk, time, cx, cz, fadeX, fadeZ)
		write(chunk)
		chunk.Tick, chunk.CenterX, chunk.CenterZ = tick, cx, cz
		chunk.Part.Parent = root
	end
end

local lastTick = -1
-- The last tick an off-screen chunk was refreshed for.
local refreshedTick = -math.huge
-- Seconds of writes since the last report, and ticks.
local spent = 0
local ticks = 0
local reportedAt = os.clock()

runService.PreRender:ConnectParallel(function()
	const camera = workspace.CurrentCamera
	const tick = root:GetAttribute("Tick")
	if not camera or type(tick) ~= "number" then
		return
	end
	const time = root:GetAttribute("Time") :: number
	const cx = root:GetAttribute("CenterX") :: number
	const cz = root:GetAttribute("CenterZ") :: number
	const fadeX = root:GetAttribute("EyeX") :: number
	const fadeZ = root:GetAttribute("EyeZ") :: number
	if tick ~= lastTick then
		lastTick = tick
		ticks += 1
	end
	updateView(camera)

	local moving = 0
	-- The off-screen chunk longest out of date, to be refreshed this tick.
	local stalest: Chunk? = nil
	for _, chunk in chunks do
		if chunk.Tick == tick then
			continue
		end
		-- (No waves: it only moves with the centre.)
		if chunk.Still and chunk.CenterX == cx and chunk.CenterZ == cz then
			chunk.Tick = tick
			continue
		end
		if not inView(chunk, cx, cz) then
			if tick - refreshedTick >= REFRESH_TICKS and (not stalest or chunk.Tick < stalest.Tick) then
				stalest = chunk
			end
			continue
		end
		solve(chunk, time, cx, cz, fadeX, fadeZ)
		chunk.Tick, chunk.CenterX, chunk.CenterZ = tick, cx, cz
		moving += 1
		pending[moving] = chunk
	end
	if stalest then
		refreshedTick = tick
		solve(stalest, time, cx, cz, fadeX, fadeZ)
		stalest.Tick, stalest.CenterX, stalest.CenterZ = tick, cx, cz
		moving += 1
		pending[moving] = stalest
	end

	const now = os.clock()
	const report = now - reportedAt >= REPORT_INTERVAL
	if moving == 0 and not report then
		return
	end
	task.synchronize()
	const started = os.clock()
	for i = 1, moving do
		write(pending[i])
		pending[i] = nil
	end
	spent += os.clock() - started
	if report then
		actor:SetAttribute("Cost", spent * 1000 / math.max(ticks, 1))
		spent, ticks, reportedAt = 0, 0, now
	end
end)
