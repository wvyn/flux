				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict

const Signal = require("../Signal")

const BooleanState = {}
const BooleanStateMethods = {}

function BooleanState.new()
	return setmetatable({
		Changed = Signal.new() :: Signal.Signal<boolean>,
		EffectAdded = Signal.new() :: Signal.Signal<BooleanElement>,
		EffectRemoved = Signal.new() :: Signal.Signal<BooleanElement>,
		Values = {} :: { BooleanElement },

		_lastValue = false,
		_destroyed = false,
	}, { __index = BooleanStateMethods })
end

function BooleanStateMethods.Destroy(self: BooleanState)
	self._destroyed = true
	self.Changed:Destroy()
	self.EffectAdded:Destroy()
	self.EffectRemoved:Destroy()
end

function BooleanStateMethods._stepChanged(self: BooleanState)
	const read = self:Read()

	if read ~= self._lastValue then
		self.Changed:Fire(read)
	end

	self._lastValue = read

	return read
end

function BooleanStateMethods.Add(self: BooleanState, value: boolean | { Value: boolean }, duration: number?)
	local element: BooleanElement = {
		Read = typeof(value) == "boolean" and { Value = value } or value :: { Value: boolean },
		Start = os.clock(),
		Duration = duration or -1
	}

	if self._destroyed then
		return element
	end

	if typeof(value) == "Instance" and value:IsA("ValueBase") then
		value.Changed:Connect(function()
			self:_stepChanged()
		end)
	end

	self.Values[#self.Values + 1] = element

	if duration then
		task.delay(duration, self.Remove, self, element)
	end

	self.EffectAdded:Fire(element)
	self:_stepChanged()
	return element
end

function BooleanStateMethods.Remove(self: BooleanState, value: BooleanElement)
	if self._destroyed then
		return
	end

	local index = table.find(self.Values, value)

	if index then
		table.remove(self.Values, index)
		self.EffectRemoved:Fire(value)
	end

	self:_stepChanged()
end

function BooleanStateMethods.Read(self: BooleanState): boolean
	local value = false

	for _, v in self.Values do
		value = value or v.Read.Value
	end

	return value
end

export type BooleanState = typeof(BooleanState.new())

export type BooleanElement = {
	read Read: { Value: boolean },
	read Start: number,
	read Duration: number
}

return BooleanState
]]></ProtectedString>
