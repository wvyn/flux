			<ProtectedString name="Source"><![CDATA[const NumericalState = require("@self/NumericalState")
const BooleanState = require("@self/BooleanState")

const StateEffects = {
	NumericalState = NumericalState,
	BooleanState = BooleanState
}

export type NumericalState = NumericalState.NumericalState
export type NumericalElement = NumericalState.NumericalElement

export type BooleanState = BooleanState.BooleanState
export type BooleanElement = BooleanState.BooleanElement

return StateEffects]]></ProtectedString>
