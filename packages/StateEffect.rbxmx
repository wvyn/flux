			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict

const Signal = require("../Signal")

const NumericalState = {}
const NumericalStateMethods = {}

function NumericalState.new()
	return setmetatable({
		Changed = Signal.new() :: Signal.Signal<number>,
		EffectAdded = Signal.new() :: Signal.Signal<NumericalElement>,
		EffectRemoved = Signal.new() :: Signal.Signal<NumericalElement>,
		Values = {} :: { NumericalElement },

		_lastValue = 0,
		_destroyed = false,
	}, { __index = NumericalStateMethods })
end

function NumericalStateMethods.Destroy(self: NumericalState)
	self._destroyed = true
	self.Changed:Destroy()
	self.EffectAdded:Destroy()
	self.EffectRemoved:Destroy()
end

function NumericalStateMethods._stepChanged(self: NumericalState)
	const read = self:Read()

	if read ~= self._lastValue then
		self.Changed:Fire(read)
	end

	self._lastValue = read

	return read
end


function NumericalStateMethods.Add(self: NumericalState, value: number | { Value: number }, duration: number?)
	local element: NumericalElement = {
		Read = typeof(value) == "number" and { Value = value } or value :: { Value: number },
		Start = os.clock(),
		Duration = duration or -1
	}

	if self._destroyed then
		return element
	end

	if typeof(value) == "Instance" and value:IsA("ValueBase") then
		value.Changed:Connect(function()
			self:_stepChanged()
		end)
	end

	self.Values[#self.Values + 1] = element

	if duration then
		task.delay(duration, self.Remove, self, element)
	end

	self.EffectAdded:Fire(element)
	self:_stepChanged()
	return element
end

function NumericalStateMethods.Remove(self: NumericalState, value: NumericalElement)
	if self._destroyed then
		return
	end

	local index = table.find(self.Values, value)

	if index then
		table.remove(self.Values, index)
		self.EffectRemoved:Fire(value)
	end

	self:_stepChanged()
end

function NumericalStateMethods.Read(self: NumericalState)
	local value = 0

	for _, v in self.Values do
		value += v.Read.Value
	end

	return value
end

export type NumericalState = typeof(NumericalState.new())
export type NumericalElement = {
	read Read: { Value : number },
	read Start: number,
	read Duration: number
}

return NumericalState
]]></ProtectedString>
