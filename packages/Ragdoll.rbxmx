<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="ModuleScript" referent="RBXD7859577FB8E45599B06E7ABD7C61220">
		<Properties>
			<Content name="LinkedSource"><null></null></Content>
			<ProtectedString name="Source"><![CDATA[const runService = game:GetService("RunService")

const Settings = require("@self/RagdollSettings")

const Ragdoll = {}
const RagdollMethods = {}

const function makeCollider(limb: BasePart, jointParent: BasePart): Instance
	const collider = Instance.new("Part")
	collider.Name = "RagdollCollider"
	collider.Size = limb.Size * Settings.ColliderScale
	collider.CFrame = limb.CFrame
	collider.Transparency = 1
	collider.Massless = true
	collider.CanCollide = true
	collider.CanQuery = false
	collider.CanTouch = false

	const weld = Instance.new("WeldConstraint")
	weld.Part0 = limb
	weld.Part1 = collider
	weld.Parent = collider

	const noCollision = Instance.new("NoCollisionConstraint")
	noCollision.Part0 = collider
	noCollision.Part1 = jointParent
	noCollision.Parent = collider

	collider.Parent = limb
	return collider
end

const function makeSocket(motor: Motor6D): { Instance }
	const attachment0 = Instance.new("Attachment")
	attachment0.Name = "RagdollAttachment"
	attachment0.CFrame = motor.C0
	attachment0.Parent = motor.Part0

	const attachment1 = Instance.new("Attachment")
	attachment1.Name = "RagdollAttachment"
	attachment1.CFrame = motor.C1
	attachment1.Parent = motor.Part1

	const socket = Instance.new("BallSocketConstraint")
	socket.Name = "RagdollSocket"
	socket.Attachment0 = attachment0
	socket.Attachment1 = attachment1
	socket.LimitsEnabled = true
	socket.UpperAngle = Settings.UpperAngle
	socket.TwistLimitsEnabled = true
	socket.TwistLowerAngle = -Settings.TwistAngle
	socket.TwistUpperAngle = Settings.TwistAngle
	socket.Parent = motor.Part1

	return { attachment0, attachment1, socket }
end

const function uprightRotation(rootPart: BasePart): CFrame
	const look = rootPart.CFrame.LookVector
	const flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		return CFrame.identity
	end
	return CFrame.lookAt(Vector3.zero, flat.Unit)
end

const function rootTarget(self: Ragdoll, torso: BasePart): CFrame
	return CFrame.new(torso.Position + Vector3.new(0, Settings.RootHeight, 0)) * self._rootRotation
end

const function enable(self: Ragdoll)
	const humanoid = self.Humanoid
	const rootPart = humanoid and humanoid.RootPart

	for _, motor in self.Rig:GetDescendants() do
		if not motor:IsA("Motor6D") or not motor.Enabled then
			continue
		end

		const part0, part1 = motor.Part0, motor.Part1
		if not part0 or not part1 then
			continue
		end

		if part0 == rootPart then
			self._torso = part1
		else
			for _, instance in makeSocket(motor) do
				self._instances[#self._instances + 1] = instance
			end
			self._instances[#self._instances + 1] = makeCollider(part1, part0)
		end

		motor.Enabled = false
		self._motors[#self._motors + 1] = motor
	end

	if humanoid then
		self._requiresNeck = humanoid.RequiresNeck
		humanoid.RequiresNeck = false
		humanoid.PlatformStand = true
	end

	const torso = self._torso
	if rootPart and torso then
		self._rootRotation = uprightRotation(rootPart)
		self._rootState = { Anchored = rootPart.Anchored, CanCollide = rootPart.CanCollide }

		rootPart.Anchored = true
		rootPart.CanCollide = false
		rootPart.CFrame = rootTarget(self, torso)

		self._follow = runService.Heartbeat:Connect(function()
			if not torso:IsDescendantOf(game) then
				if self._follow then
					self._follow:Disconnect()
					self._follow = nil
				end
				return
			end

			rootPart.CFrame = rootTarget(self, torso)
		end)
	end
end

const function disable(self: Ragdoll)
	if self._follow then
		self._follow:Disconnect()
		self._follow = nil
	end

	for _, instance in self._instances do
		instance:Destroy()
	end
	table.clear(self._instances)

	const humanoid = self.Humanoid
	const rootPart = humanoid and humanoid.RootPart
	const torso = self._torso
	const rootState = self._rootState

	if rootPart and rootState then
		if torso and self.Rig:IsDescendantOf(workspace) then
			rootPart.CFrame = rootTarget(self, torso)
		end
		rootPart.Anchored = rootState.Anchored
		rootPart.CanCollide = rootState.CanCollide
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end

	for _, motor in self._motors do
		if motor.Parent then
			motor.Enabled = true
		end
	end
	table.clear(self._motors)

	if humanoid then
		humanoid.PlatformStand = false
		humanoid.RequiresNeck = self._requiresNeck
	end

	self._torso = nil
	self._rootState = nil
end

function Ragdoll.new(rig: Model): Ragdoll
	const self = setmetatable({
		Rig = rig,
		Humanoid = rig:FindFirstChildOfClass("Humanoid"),
		Enabled = false,

		_motors = {} :: { Motor6D },
		_instances = {} :: { Instance },
		_requiresNeck = true,
		_torso = nil :: BasePart?,
		_rootRotation = CFrame.identity,
		_rootState = nil :: { Anchored: boolean, CanCollide: boolean }?,
		_follow = nil :: RBXScriptConnection?,
	}, { __index = RagdollMethods })

	return self
end

function RagdollMethods.Toggle(self: Ragdoll, enabled: boolean?)
	const target = if enabled == nil then not self.Enabled else enabled
	if target == self.Enabled then
		return
	end

	self.Enabled = target
	if target then
		enable(self)
	else
		disable(self)
	end
end

function RagdollMethods.Destroy(self: Ragdoll)
	self:Toggle(false)
end

export type Ragdoll = typeof(setmetatable({} :: {
	Rig: Model,
	Humanoid: Humanoid?,
	Enabled: boolean,

	_motors: { Motor6D },
	_instances: { Instance },
	_requiresNeck: boolean,
	_torso: BasePart?,
	_rootRotation: CFrame,
	_rootState: { Anchored: boolean, CanCollide: boolean }?,
	_follow: RBXScriptConnection?,
}, { __index = RagdollMethods }))

return Ragdoll
]]></ProtectedString>
