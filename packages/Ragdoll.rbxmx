		<Item class="ModuleScript" referent="RBX5AA2BC0460834EC4ABA4136F4750EB15">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[return {
	-- How far (degrees) a limb can swing away from its rest direction.
	UpperAngle = 60,

	-- How far (degrees) a limb can twist either way around itself.
	TwistAngle = 45,

	-- Size of each limb's invisible collider relative to the limb. Limbs don't
	-- collide on their own (the Humanoid handles that normally), so without
	-- these they'd fall through the floor.
	ColliderScale = 0.85,

	-- Studs above the torso the detached HumanoidRootPart floats while
	-- ragdolled. Also where the character stands back up from, so the get-up
	-- doesn't start stuck in the ground.
	RootHeight = 2.5,
}
]]></ProtectedString>
