				<ProtectedString name="Source"><![CDATA[const Security = require("./Security")

const Network = {
	-- Second remote argument on every packet: what the payload is for.
	Kind = table.freeze({
		Message = 0,
		Request = 1,
		Response = 2,
	}),

	DefaultRequestTimeout = 10,
}

--[[
	Every object listening on a remote is handed the same argument values
	for a given fire, so objects sharing an eventId decode each packet once
	instead of once per object. Weak keys: an entry disappears along with
	its buffer, so nothing here outlives the packet it describes.
]]
const decodeCache = setmetatable({}, { __mode = "k" }) :: { [buffer]: { any } }

-- Unique per VM (not per object) so two objects sharing an eventId can
-- never mistake each other's responses for their own.
local lastRequestId = 0

function Network.NextRequestId(): number
	lastRequestId += 1
	return lastRequestId
end

function Network.ValidateHeader(kind: any, requestId: any): boolean
	if kind == Network.Kind.Message then
		return true
	end

	if kind ~= Network.Kind.Request and kind ~= Network.Kind.Response then
		return false
	end

	-- NaN and inf both fail `% 1 == 0`.
	return type(requestId) == "number" and requestId > 0 and requestId % 1 == 0
end

--[[
	refs rides along on the remote as a plain, attacker-shaped table. Walk
	every entry (not just 1..#refs, which sparse tables can hide from) and
	bail on the first thing that isn't a real Instance.
]]
function Network.ValidateRefs(refs: any): boolean
	if refs == nil then
		return true
	end

	if type(refs) ~= "table" then
		return false
	end

	local count = 0
	for _, ref in refs do
		count += 1
		if count > Security.MaxRefs or typeof(ref) ~= "Instance" then
			return false
		end
	end

	return true
end

function Network.CheckPacketSize(self: any, rawBuffer: buffer): string?
	const maxPacketSize = self:GetMaxPacketSize()
	const size = buffer.len(rawBuffer)
	if size > maxPacketSize then
		return `packet of {size} bytes exceeds max size of {maxPacketSize} bytes`
	end
	return nil
end

-- Token bucket per (player, object), refilled continuously.
function Network.CheckRateLimit(self: any, player: Player): boolean
	const rate = self:GetRateLimit()
	const now = os.clock()

	const bucket = self._buckets[player]
	if not bucket then
		self._buckets[player] = { Tokens = rate - 1, Last = now }
		return true
	end

	bucket.Tokens = math.min(rate, bucket.Tokens + (now - bucket.Last) * rate)
	bucket.Last = now

	if bucket.Tokens < 1 then
		return false
	end

	bucket.Tokens -= 1
	return true
end

-- Returns (ok, packed) where packed is a table.pack of the decoded values,
-- or the error message when ok is false.
function Network.Decode(self: any, rawBuffer: buffer, refs: { Instance }?): (boolean, any)
	local cached = decodeCache[rawBuffer]
	if not cached then
		const ok, result = pcall(function()
			return table.pack(self:Deserialize(rawBuffer, refs))
		end)
		cached = { ok, result }
		decodeCache[rawBuffer] = cached
	end

	return cached[1], cached[2]
end

return Network
]]></ProtectedString>
