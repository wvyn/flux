				<ProtectedString name="Source"><![CDATA[--!strict

const runService = game:GetService("RunService")

const eventFunctionName = runService:IsClient() and "FireServer" or "FireClient"
const eventGlobalFunctionName = runService:IsClient() and "FireServer" or "FireAllClients"

const reliableRemoteEvent = script:WaitForChild("ReliableRemoteEvent")
local unreliableRemoteEvent = script:WaitForChild("UnreliableRemoteEvent")
local remoteFunction = script:WaitForChild("RemoteFunction")

return {
	RunService = runService,

	EventFunctionName = eventFunctionName,
	EventGlobalFunctionName = eventGlobalFunctionName,

	ReliableRemoteEvent = reliableRemoteEvent,
	UnreliableRemoteEvent = unreliableRemoteEvent,
	RemoteFunction = remoteFunction,
}
]]></ProtectedString>
