	<Item class="ModuleScript" referent="RBXF3BBC77165E34108A22EAF876C10C101">
		<Properties>
			<Content name="LinkedSource"><null></null></Content>
			<ProtectedString name="Source"><![CDATA[--[[ Serial by wyverndayo ]]

const Signal = require("./Signal")

const BufferWriter = require("@self/BufferWriter")
const BufferReader = require("@self/BufferReader")
const Codec = require("@self/Codec")
const Remotes = require("@self/Remotes")
const Security = require("@self/Security")
const Network = require("@self/Network")

const runService = game:GetService("RunService")
const players = game:GetService("Players")

const reliableRemoteEvent = Remotes.ReliableRemoteEvent
const unreliableRemoteEvent = Remotes.UnreliableRemoteEvent

const Kind = Network.Kind

const function destroySignal(signal: any)
	if not signal then
		return
	elseif type(signal.Destroy) == "function" then
		signal:Destroy()
	elseif type(signal.DisconnectAll) == "function" then
		signal:DisconnectAll()
	end
end

const function trackRequest(self: any, player: Player?): number
	const requestId = Network.NextRequestId()
	const thread = coroutine.running()

	self._pending[requestId] = {
		Thread = thread,
		Player = player,
		Timeout = task.delay(self.RequestTimeout or Network.DefaultRequestTimeout, function()
			if self._pending[requestId] then
				self._pending[requestId] = nil
				task.spawn(thread)
			end
		end),
	}

	return requestId
end

const function cancelRequest(self: any, requestId: number)
	const pending = self._pending[requestId]
	self._pending[requestId] = nil
	task.cancel(pending.Timeout)
	task.spawn(pending.Thread)
end

const function resolveRequest(self: any, requestId: number, player: Player?, packed: any)
	const pending = self._pending[requestId]
	if not pending then
		return
	end

	if pending.Player ~= player then
		Security.SecurityViolation:Fire(player, self.EventId, "response from a player the request wasn't sent to")
		return
	end

	self._pending[requestId] = nil
	task.cancel(pending.Timeout)
	task.spawn(pending.Thread, table.unpack(packed, 1, packed.n))
end

const function respond(self: any, player: Player?, packed: any): (buffer, { Instance })
	const requested = self.Requested

	local ok, responses
	if player then
		ok, responses = pcall(requested.Invoke, requested, player, table.unpack(packed, 1, packed.n))
	else
		ok, responses = pcall(requested.Invoke, requested, table.unpack(packed, 1, packed.n))
	end

	if not ok then
		task.spawn(error, responses, 0)
	elseif type(responses) == "table" and responses[1] ~= nil then
		return self:Serialize(responses[1])
	end

	return self:Serialize()
end

const function accept(self: any, player: Player?, kind: any, requestId: any, rawBuffer: any, refs: any): any?
	const eventId = self.EventId

	if player and not Network.CheckRateLimit(self, player) then
		Security.SecurityViolation:Fire(player, eventId, "rate limit exceeded")
		return nil
	end

	if type(rawBuffer) ~= "buffer" or not Network.ValidateHeader(kind, requestId) then
		Security.SecurityViolation:Fire(player, eventId, "malformed packet header")
		return nil
	end

	const sizeReason = Network.CheckPacketSize(self, rawBuffer)
	if sizeReason then
		Security.SecurityViolation:Fire(player, eventId, sizeReason)
		return nil
	end

	if not Network.ValidateRefs(refs) then
		Security.SecurityViolation:Fire(player, eventId, "invalid instance refs")
		return nil
	end

	const ok, packed = Network.Decode(self, rawBuffer, refs)
	if not ok then
		Security.SecurityViolation:Fire(player, eventId, `deserialize failed: {packed}`)
		return nil
	end

	return packed
end

const function onServerPacket(self: any, player: Player, kind: any, requestId: any, rawBuffer: any, refs: any)
	const packed = accept(self, player, kind, requestId, rawBuffer, refs)
	if not packed then
		return
	end

	if kind == Kind.Message then
		self.RawReceived:Fire(player, rawBuffer)
		self.Received:Fire(player, table.unpack(packed, 1, packed.n))
	elseif kind == Kind.Request then
		const responseBuffer, responseRefs = respond(self, player, packed)
		reliableRemoteEvent:FireClient(player, self.EventId, Kind.Response, requestId, responseBuffer, responseRefs)
	else
		resolveRequest(self, requestId, player, packed)
	end
end

const function onClientPacket(self: any, kind: any, requestId: any, rawBuffer: any, refs: any)
	const packed = accept(self, nil, kind, requestId, rawBuffer, refs)
	if not packed then
		return
	end

	if kind == Kind.Message then
		self.RawReceived:Fire(rawBuffer)
		self.Received:Fire(table.unpack(packed, 1, packed.n))
	elseif kind == Kind.Request then
		const responseBuffer, responseRefs = respond(self, nil, packed)
		reliableRemoteEvent:FireServer(self.EventId, Kind.Response, requestId, responseBuffer, responseRefs)
	else
		resolveRequest(self, requestId, nil, packed)
	end
end

--

const SerialSharedMethods = {}

function SerialSharedMethods.Serialize<data...>(self: SerialServer<data...> | SerialClient<data...>, ...: data...): (buffer, { Instance })
	const writer = BufferWriter.new()
	const count = select("#", ...)

	writer:WriteU8(count)
	for index = 1, count do
		Codec.WriteValue(writer, (select(index, ...)))
	end

	return writer:Finalize(), writer.Refs
end

function SerialSharedMethods.Deserialize<data...>(self: SerialServer<data...> | SerialClient<data...>, rawBuffer: buffer, refs: { Instance }?): data...
	const reader = BufferReader.new(rawBuffer)
	const count = reader:ReadU8()

	const results = table.create(count)
	for index = 1, count do
		results[index] = Codec.ReadValue(reader, refs)
	end

	return table.unpack(results, 1, count)
end

-- Per-object override for the max accepted packet size, in bytes. nil falls
-- back to Serial.SetMaxPacketSize. Enforced by whichever side receives.
function SerialSharedMethods.SetMaxPacketSize<data...>(self: SerialServer<data...> | SerialClient<data...>, bytes: number?)
	self.MaxPacketSize = bytes
end

function SerialSharedMethods.GetMaxPacketSize<data...>(self: SerialServer<data...> | SerialClient<data...>): number
	return Security.ClampPacketSize(self.MaxPacketSize)
end

-- Per-object override for max messages/sec from a single player. nil falls
-- back to Serial.SetRateLimit. Only enforced on the server.
function SerialSharedMethods.SetRateLimit<data...>(self: SerialServer<data...> | SerialClient<data...>, perSecond: number?)
	self.RateLimit = perSecond
end

function SerialSharedMethods.GetRateLimit<data...>(self: SerialServer<data...> | SerialClient<data...>): number
	return Security.ClampRateLimit(self.RateLimit)
end

function SerialSharedMethods.Destroy<data...>(self: SerialServer<data...> | SerialClient<data...>)
	if self._destroyed then
		return
	end
	self._destroyed = true

	for _, connection in self._connections do
		connection:Disconnect()
	end
	table.clear(self._connections)

	for requestId in self._pending do
		cancelRequest(self, requestId)
	end

	destroySignal(self.RawReceived)
	destroySignal(self.Received)
	destroySignal(self.Requested)

	if self._buckets then
		table.clear(self._buckets)
	end
end

--

const SerialServerMethods = setmetatable({}, { __index = SerialSharedMethods })

function SerialServerMethods.SendGlobalTCP<data...>(self: SerialServer<data...>, ...: data...)
	const serialized, refs = self:Serialize(...)
	reliableRemoteEvent:FireAllClients(self.EventId, Kind.Message, 0, serialized, refs)
end

function SerialServerMethods.SendGlobalUDP<data...>(self: SerialServer<data...>, ...: data...)
	const serialized, refs = self:Serialize(...)
	unreliableRemoteEvent:FireAllClients(self.EventId, Kind.Message, 0, serialized, refs)
end

function SerialServerMethods.SendTCP<data...>(self: SerialServer<data...>, player: Player, ...: data...)
	const serialized, refs = self:Serialize(...)
	reliableRemoteEvent:FireClient(player, self.EventId, Kind.Message, 0, serialized, refs)
end

function SerialServerMethods.SendUDP<data...>(self: SerialServer<data...>, player: Player, ...: data...)
	const serialized, refs = self:Serialize(...)
	unreliableRemoteEvent:FireClient(player, self.EventId, Kind.Message, 0, serialized, refs)
end

-- Yields until the client answers. Returns nothing if the client doesn't
-- answer within RequestTimeout, leaves, or this object is destroyed.
function SerialServerMethods.Request<data...>(self: SerialServer<data...>, player: Player, ...: data...): data...
	if self._destroyed then
		return
	end

	const serialized, refs = self:Serialize(...)
	const requestId = trackRequest(self, player)
	reliableRemoteEvent:FireClient(player, self.EventId, Kind.Request, requestId, serialized, refs)
	return coroutine.yield()
end

--

const SerialClientMethods = setmetatable({}, { __index = SerialSharedMethods })

function SerialClientMethods.SendTCP<data...>(self: SerialClient<data...>, ...: data...)
	const serialized, refs = self:Serialize(...)
	reliableRemoteEvent:FireServer(self.EventId, Kind.Message, 0, serialized, refs)
end

function SerialClientMethods.SendUDP<data...>(self: SerialClient<data...>, ...: data...)
	const serialized, refs = self:Serialize(...)
	unreliableRemoteEvent:FireServer(self.EventId, Kind.Message, 0, serialized, refs)
end

-- Yields until the server answers. Returns nothing on timeout or Destroy.
function SerialClientMethods.Request<data...>(self: SerialClient<data...>, ...: data...): data...
	if self._destroyed then
		return
	end

	const serialized, refs = self:Serialize(...)
	const requestId = trackRequest(self, nil)
	reliableRemoteEvent:FireServer(self.EventId, Kind.Request, requestId, serialized, refs)
	return coroutine.yield()
end

--

const Serial = {
	Server = {},
	Client = {},

	-- Default inbound limits for this side; per-object overrides go in the
	-- config passed to Server.new/Client.new.
	SetMaxPacketSize = Security.SetMaxPacketSize,
	GetMaxPacketSize = Security.GetMaxPacketSize,
	SetRateLimit = Security.SetRateLimit,
	GetRateLimit = Security.GetRateLimit,

	-- (player: Player?, eventId: string, reason: string) -- fires whenever an
	-- inbound packet is dropped. player is nil on the client.
	SecurityViolation = Security.SecurityViolation,
}

--[[
	No registry: the object is kept alive only by its own connections to the
	remotes. Those connections belong to whichever script's thread called
	new(), so when that script is destroyed Roblox disconnects them and the
	object gets garbage collected -- no local reference needed.
]]
function Serial.Server.new<data...>(eventId: string, config: SerialConfig?): SerialServer<data...>
	assert(runService:IsServer(), "Serial.Server.new can only be called on the server")

	const self = setmetatable({
		EventId = eventId,
		MaxPacketSize = config and config.MaxPacketSize,
		RateLimit = config and config.RateLimit,
		RequestTimeout = config and config.RequestTimeout,

		RawReceived = Signal.new() :: Signal.Signal<Player, buffer>,
		Received = Signal.new() :: Signal.Signal<Player, data...>,
		Requested = Signal.new() :: Signal.Signal<Player, data...>,

		_connections = {} :: { RBXScriptConnection },
		_pending = {},
		_buckets = {},
		_destroyed = false,
	}, { __index = SerialServerMethods })

	const function onEvent(player: Player, id: any, kind: any, requestId: any, rawBuffer: any, refs: any)
		if id == eventId then
			onServerPacket(self, player, kind, requestId, rawBuffer, refs)
		end
	end

	self._connections = {
		reliableRemoteEvent.OnServerEvent:Connect(onEvent),
		unreliableRemoteEvent.OnServerEvent:Connect(onEvent),
		players.PlayerRemoving:Connect(function(player: Player)
			self._buckets[player] = nil
			for requestId, pending in self._pending do
				if pending.Player == player then
					cancelRequest(self, requestId)
				end
			end
		end),
	}

	return self
end

function Serial.Client.new<data...>(eventId: string, config: SerialConfig?): SerialClient<data...>
	assert(runService:IsClient(), "Serial.Client.new can only be called on the client")

	const self = setmetatable({
		EventId = eventId,
		MaxPacketSize = config and config.MaxPacketSize,
		RateLimit = config and config.RateLimit,
		RequestTimeout = config and config.RequestTimeout,

		RawReceived = Signal.new() :: Signal.Signal<buffer>,
		Received = Signal.new() :: Signal.Signal<data...>,
		Requested = Signal.new() :: Signal.Signal<data...>,

		_connections = {} :: { RBXScriptConnection },
		_pending = {},
		_destroyed = false,
	}, { __index = SerialClientMethods })

	const function onEvent(id: any, kind: any, requestId: any, rawBuffer: any, refs: any)
		if id == eventId then
			onClientPacket(self, kind, requestId, rawBuffer, refs)
		end
	end

	self._connections = {
		reliableRemoteEvent.OnClientEvent:Connect(onEvent),
		unreliableRemoteEvent.OnClientEvent:Connect(onEvent),
	}

	return self
end

--

export type SerialConfig = {
	-- Max accepted inbound packet size, in bytes. Falls back to
	-- Serial.SetMaxPacketSize's value when omitted.
	MaxPacketSize: number?,

	-- Max accepted messages/sec, per player. Server-only; falls back to
	-- Serial.SetRateLimit's value when omitted.
	RateLimit: number?,

	-- Seconds Request waits for an answer before returning nothing.
	RequestTimeout: number?,
}

export type _serialServerMethods<data...> = {
	read SetMaxPacketSize: (self: SerialServer<data...>, bytes: number?) -> (),
	read GetMaxPacketSize: (self: SerialServer<data...>) -> number,
	read SetRateLimit: (self: SerialServer<data...>, perSecond: number?) -> (),
	read GetRateLimit: (self: SerialServer<data...>) -> number,
	read Destroy: (self: SerialServer<data...>) -> (),

	read SendGlobalTCP: (self: SerialServer<data...>, data...) -> (),
	read SendGlobalUDP: (self: SerialServer<data...>, data...) -> (),

	read SendTCP: (self: SerialServer<data...>, player: Player, data...) -> (),
	read SendUDP: (self: SerialServer<data...>, player: Player, data...) -> (),

	read Request: (self: SerialServer<data...>, player: Player, data...) -> data...,

	read Serialize: (self: SerialServer<data...>, data...) -> (buffer, { Instance }),
	read Deserialize: (self: SerialServer<data...>, rawBuffer: buffer, refs: { Instance }?) -> data...,
}

export type _serialClientMethods<data...> = {
	read SetMaxPacketSize: (self: SerialClient<data...>, bytes: number?) -> (),
	read GetMaxPacketSize: (self: SerialClient<data...>) -> number,
	read SetRateLimit: (self: SerialClient<data...>, perSecond: number?) -> (),
	read GetRateLimit: (self: SerialClient<data...>) -> number,
	read Destroy: (self: SerialClient<data...>) -> (),

	read SendTCP: (self: SerialClient<data...>, data...) -> (),
	read SendUDP: (self: SerialClient<data...>, data...) -> (),

	read Request: (self: SerialClient<data...>, data...) -> data...,

	read Serialize: (self: SerialClient<data...>, data...) -> (buffer, { Instance }),
	read Deserialize: (self: SerialClient<data...>, rawBuffer: buffer, refs: { Instance }?) -> data...,
}

export type SerialServer<data...> = setmetatable<{
	read EventId: string,
	MaxPacketSize: number?,
	RateLimit: number?,
	RequestTimeout: number?,

	read RawReceived: Signal.Signal<Player, buffer>,
	read Received: Signal.Signal<Player, data...>,
	read Requested: Signal.Signal<Player, data...>,
}, { __index: _serialServerMethods<data...> }>

export type SerialClient<data...> = setmetatable<{
	read EventId: string,
	MaxPacketSize: number?,
	RateLimit: number?,
	RequestTimeout: number?,

	read RawReceived: Signal.Signal<buffer>,
	read Received: Signal.Signal<data...>,
	read Requested: Signal.Signal<data...>,
}, { __index: _serialClientMethods<data...> }>

return Serial
