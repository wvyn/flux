				<ProtectedString name="Source"><![CDATA[--!strict

const Signal = require("../Signal")

const minMaxPacketSize = 64
const absoluteMaxPacketSize = 65536

const minRateLimit = 1
const absoluteMaxRateLimit = 1000

local maxPacketSize = 1024
local rateLimit = 500 -- messages/sec, per player, per link

const Security = {
	MaxRefs = 1024,

	-- (player: Player?, eventId: string, reason: string) -- player is nil when raised on the client
	SecurityViolation = Signal.new() :: Signal.Signal<Player?, string, string>,
}

function Security.SetMaxPacketSize(bytes: number)
	assert(type(bytes) == "number" and bytes == bytes, "Serial: MaxPacketSize must be a number")
	maxPacketSize = math.clamp(math.floor(bytes), minMaxPacketSize, absoluteMaxPacketSize)
end

function Security.GetMaxPacketSize(): number
	return maxPacketSize
end

function Security.ClampPacketSize(bytes: number?): number
	if bytes == nil then
		return maxPacketSize
	end
	return math.clamp(math.floor(bytes), minMaxPacketSize, absoluteMaxPacketSize)
end

function Security.SetRateLimit(perSecond: number)
	assert(type(perSecond) == "number" and perSecond == perSecond, "Serial: RateLimit must be a number")
	rateLimit = math.clamp(math.floor(perSecond), minRateLimit, absoluteMaxRateLimit)
end

function Security.GetRateLimit(): number
	return rateLimit
end

function Security.ClampRateLimit(perSecond: number?): number
	if perSecond == nil then
		return rateLimit
	end
	return math.clamp(math.floor(perSecond), minRateLimit, absoluteMaxRateLimit)
end

return Security
]]></ProtectedString>
