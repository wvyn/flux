			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[const Codec = {}

const TypeTag = table.freeze({
	Nil = 0,
	False = 1,
	True = 2,
	Integer = 3,
	Number = 4,
	String = 5,
	Array = 6,
	Map = 7,

	Vector2 = 8,
	Vector3 = 9,
	Vector2int16 = 10,
	Vector3int16 = 11,
	CFrame = 12,
	Color3 = 13,
	BrickColor = 14,

	UDim = 15,
	UDim2 = 16,
	Rect = 17,
	NumberRange = 18,
	NumberSequence = 19,
	ColorSequence = 20,

	EnumItem = 21,
	TweenInfo = 22,
	DateTime = 23,
	Ray = 24,
	Region3 = 25,
	Region3int16 = 26,
	Faces = 27,
	Axes = 28,

	-- Not encoded into the buffer at all -- see the file header comment.
	Instance = 29,
})

const NORMAL_IDS = {
	Enum.NormalId.Top,
	Enum.NormalId.Bottom,
	Enum.NormalId.Left,
	Enum.NormalId.Right,
	Enum.NormalId.Back,
	Enum.NormalId.Front,
}

const AXES = { Enum.Axis.X, Enum.Axis.Y, Enum.Axis.Z }

const MIN_I32 = -2147483648
const MAX_I32 = 2147483647

const MAX_DEPTH = 64

function Codec.WriteValue(writer, value: any, depth: number?)
	const currentDepth = depth or 0
	if currentDepth > MAX_DEPTH then
		error(`Serial: value exceeds maximum nesting depth of {MAX_DEPTH}`)
	end

	const valueType = typeof(value)

	if value == nil then
		writer:WriteU8(TypeTag.Nil)
	elseif valueType == "boolean" then
		writer:WriteU8(value and TypeTag.True or TypeTag.False)
	elseif valueType == "number" then
		if value % 1 == 0 and value >= MIN_I32 and value <= MAX_I32 then
			writer:WriteU8(TypeTag.Integer)
			writer:WriteI32(value)
		else
			writer:WriteU8(TypeTag.Number)
			writer:WriteF64(value)
		end
	elseif valueType == "string" then
		writer:WriteU8(TypeTag.String)
		writer:WriteString(value)
	elseif valueType == "Vector2" then
		writer:WriteU8(TypeTag.Vector2)
		writer:WriteF32(value.X)
		writer:WriteF32(value.Y)
	elseif valueType == "Vector3" then
		writer:WriteU8(TypeTag.Vector3)
		writer:WriteF32(value.X)
		writer:WriteF32(value.Y)
		writer:WriteF32(value.Z)
	elseif valueType == "Vector2int16" then
		writer:WriteU8(TypeTag.Vector2int16)
		writer:WriteI16(value.X)
		writer:WriteI16(value.Y)
	elseif valueType == "Vector3int16" then
		writer:WriteU8(TypeTag.Vector3int16)
		writer:WriteI16(value.X)
		writer:WriteI16(value.Y)
		writer:WriteI16(value.Z)
	elseif valueType == "CFrame" then
		writer:WriteU8(TypeTag.CFrame)
		const position = value.Position
		writer:WriteF32(position.X)
		writer:WriteF32(position.Y)
		writer:WriteF32(position.Z)
		const rx, ry, rz = value:ToOrientation()
		writer:WriteF32(rx)
		writer:WriteF32(ry)
		writer:WriteF32(rz)
	elseif valueType == "Color3" then
		writer:WriteU8(TypeTag.Color3)
		writer:WriteU8(math.floor(value.R * 255 + 0.5))
		writer:WriteU8(math.floor(value.G * 255 + 0.5))
		writer:WriteU8(math.floor(value.B * 255 + 0.5))
	elseif valueType == "BrickColor" then
		writer:WriteU8(TypeTag.BrickColor)
		writer:WriteU32(value.Number)
	elseif valueType == "UDim" then
		writer:WriteU8(TypeTag.UDim)
		writer:WriteF32(value.Scale)
		writer:WriteI32(value.Offset)
	elseif valueType == "UDim2" then
		writer:WriteU8(TypeTag.UDim2)
		writer:WriteF32(value.X.Scale)
		writer:WriteI32(value.X.Offset)
		writer:WriteF32(value.Y.Scale)
		writer:WriteI32(value.Y.Offset)
	elseif valueType == "Rect" then
		writer:WriteU8(TypeTag.Rect)
		writer:WriteF32(value.Min.X)
		writer:WriteF32(value.Min.Y)
		writer:WriteF32(value.Max.X)
		writer:WriteF32(value.Max.Y)
	elseif valueType == "NumberRange" then
		writer:WriteU8(TypeTag.NumberRange)
		writer:WriteF32(value.Min)
		writer:WriteF32(value.Max)
	elseif valueType == "NumberSequence" then
		writer:WriteU8(TypeTag.NumberSequence)
		const keypoints = value.Keypoints
		writer:WriteU32(#keypoints)
		for _, keypoint in keypoints do
			writer:WriteF32(keypoint.Time)
			writer:WriteF32(keypoint.Value)
			writer:WriteF32(keypoint.Envelope)
		end
	elseif valueType == "ColorSequence" then
		writer:WriteU8(TypeTag.ColorSequence)
		const keypoints = value.Keypoints
		writer:WriteU32(#keypoints)
		for _, keypoint in keypoints do
			writer:WriteF32(keypoint.Time)
			const color = keypoint.Value
			writer:WriteU8(math.floor(color.R * 255 + 0.5))
			writer:WriteU8(math.floor(color.G * 255 + 0.5))
			writer:WriteU8(math.floor(color.B * 255 + 0.5))
		end
	elseif valueType == "EnumItem" then
		writer:WriteU8(TypeTag.EnumItem)
		writer:WriteString(tostring(value.EnumType))
		writer:WriteString(value.Name)
	elseif valueType == "TweenInfo" then
		writer:WriteU8(TypeTag.TweenInfo)
		writer:WriteF32(value.Time)
		writer:WriteString(value.EasingStyle.Name)
		writer:WriteString(value.EasingDirection.Name)
		writer:WriteI32(value.RepeatCount)
		writer:WriteU8(value.Reverses and 1 or 0)
		writer:WriteF32(value.DelayTime)
	elseif valueType == "DateTime" then
		writer:WriteU8(TypeTag.DateTime)
		writer:WriteF64(value.UnixTimestampMillis)
	elseif valueType == "Ray" then
		writer:WriteU8(TypeTag.Ray)
		writer:WriteF32(value.Origin.X)
		writer:WriteF32(value.Origin.Y)
		writer:WriteF32(value.Origin.Z)
		writer:WriteF32(value.Direction.X)
		writer:WriteF32(value.Direction.Y)
		writer:WriteF32(value.Direction.Z)
	elseif valueType == "Region3" then
		writer:WriteU8(TypeTag.Region3)
		const center = value.CFrame.Position
		const half = value.Size / 2
		writer:WriteF32(center.X - half.X)
		writer:WriteF32(center.Y - half.Y)
		writer:WriteF32(center.Z - half.Z)
		writer:WriteF32(center.X + half.X)
		writer:WriteF32(center.Y + half.Y)
		writer:WriteF32(center.Z + half.Z)
	elseif valueType == "Region3int16" then
		writer:WriteU8(TypeTag.Region3int16)
		writer:WriteI16(value.Min.X)
		writer:WriteI16(value.Min.Y)
		writer:WriteI16(value.Min.Z)
		writer:WriteI16(value.Max.X)
		writer:WriteI16(value.Max.Y)
		writer:WriteI16(value.Max.Z)
	elseif valueType == "Faces" then
		writer:WriteU8(TypeTag.Faces)
		local mask = 0
		for index, normalId in NORMAL_IDS do
			if (value :: Faces)[normalId.Name] then
				mask += bit32.lshift(1, index - 1)
			end
		end
		writer:WriteU8(mask)
	elseif valueType == "Axes" then
		writer:WriteU8(TypeTag.Axes)
		local mask = 0
		for index, axis in AXES do
			if (value :: Axes)[axis.Name] then
				mask += bit32.lshift(1, index - 1)
			end
		end
		writer:WriteU8(mask)
	elseif valueType == "Instance" then
		writer:WriteU8(TypeTag.Instance)
		writer:WriteInstance(value)
	elseif valueType == "table" then
		const arrayLength = #value
		local totalCount = 0
		local isArray = true

		for key in next, value do
			totalCount += 1
			if typeof(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > arrayLength then
				isArray = false
			end
		end

		if isArray and totalCount == arrayLength then
			writer:WriteU8(TypeTag.Array)
			writer:WriteU32(arrayLength)
			for index = 1, arrayLength do
				Codec.WriteValue(writer, value[index], currentDepth + 1)
			end
		else
			writer:WriteU8(TypeTag.Map)
			writer:WriteU32(totalCount)
			for key, mapValue in next, value do
				Codec.WriteValue(writer, key, currentDepth + 1)
				Codec.WriteValue(writer, mapValue, currentDepth + 1)
			end
		end
	else
		error(`Serial: cannot serialize value of type "{valueType}"`)
	end
end

function Codec.ReadValue(reader, refs: { Instance }?, depth: number?): any
	const currentDepth = depth or 0
	if currentDepth > MAX_DEPTH then
		error(`Serial: value exceeds maximum nesting depth of {MAX_DEPTH}`)
	end

	const tag = reader:ReadU8()

	if tag == TypeTag.Nil then
		return nil
	elseif tag == TypeTag.False then
		return false
	elseif tag == TypeTag.True then
		return true
	elseif tag == TypeTag.Integer then
		return reader:ReadI32()
	elseif tag == TypeTag.Number then
		return reader:ReadF64()
	elseif tag == TypeTag.String then
		return reader:ReadString()
	elseif tag == TypeTag.Vector2 then
		const x = reader:ReadF32()
		const y = reader:ReadF32()
		return Vector2.new(x, y)
	elseif tag == TypeTag.Vector3 then
		const x = reader:ReadF32()
		const y = reader:ReadF32()
		const z = reader:ReadF32()
		return Vector3.new(x, y, z)
	elseif tag == TypeTag.Vector2int16 then
		const x = reader:ReadI16()
		const y = reader:ReadI16()
		return Vector2int16.new(x, y)
	elseif tag == TypeTag.Vector3int16 then
		const x = reader:ReadI16()
		const y = reader:ReadI16()
		const z = reader:ReadI16()
		return Vector3int16.new(x, y, z)
	elseif tag == TypeTag.CFrame then
		const x = reader:ReadF32()
		const y = reader:ReadF32()
		const z = reader:ReadF32()
		const rx = reader:ReadF32()
		const ry = reader:ReadF32()
		const rz = reader:ReadF32()
		return CFrame.new(x, y, z) * CFrame.fromOrientation(rx, ry, rz)
	elseif tag == TypeTag.Color3 then
		const r = reader:ReadU8()
		const g = reader:ReadU8()
		const b = reader:ReadU8()
		return Color3.fromRGB(r, g, b)
	elseif tag == TypeTag.BrickColor then
		return BrickColor.new(reader:ReadU32())
	elseif tag == TypeTag.UDim then
		const scale = reader:ReadF32()
		const offset = reader:ReadI32()
		return UDim.new(scale, offset)
	elseif tag == TypeTag.UDim2 then
		const xScale = reader:ReadF32()
		const xOffset = reader:ReadI32()
		const yScale = reader:ReadF32()
		const yOffset = reader:ReadI32()
		return UDim2.new(xScale, xOffset, yScale, yOffset)
	elseif tag == TypeTag.Rect then
		const minX = reader:ReadF32()
		const minY = reader:ReadF32()
		const maxX = reader:ReadF32()
		const maxY = reader:ReadF32()
		return Rect.new(minX, minY, maxX, maxY)
	elseif tag == TypeTag.NumberRange then
		const min = reader:ReadF32()
		const max = reader:ReadF32()
		return NumberRange.new(min, max)
	elseif tag == TypeTag.NumberSequence then
		const count = reader:ReadU32()
		if count > reader:Remaining() then
			error(`Serial: keypoint count {count} exceeds remaining buffer size`)
		end
		const keypoints = table.create(count)
		for index = 1, count do
			const time = reader:ReadF32()
			const value = reader:ReadF32()
			const envelope = reader:ReadF32()
			keypoints[index] = NumberSequenceKeypoint.new(time, value, envelope)
		end
		return NumberSequence.new(keypoints)
	elseif tag == TypeTag.ColorSequence then
		const count = reader:ReadU32()
		if count > reader:Remaining() then
			error(`Serial: keypoint count {count} exceeds remaining buffer size`)
		end
		const keypoints = table.create(count)
		for index = 1, count do
			const time = reader:ReadF32()
			const r = reader:ReadU8()
			const g = reader:ReadU8()
			const b = reader:ReadU8()
			keypoints[index] = ColorSequenceKeypoint.new(time, Color3.fromRGB(r, g, b))
		end
		return ColorSequence.new(keypoints)
	elseif tag == TypeTag.EnumItem then
		const enumTypeName = reader:ReadString()
		const itemName = reader:ReadString()
		return (Enum :: any)[enumTypeName][itemName]
	elseif tag == TypeTag.TweenInfo then
		const time = reader:ReadF32()
		const easingStyle = reader:ReadString()
		const easingDirection = reader:ReadString()
		const repeatCount = reader:ReadI32()
		const reverses = reader:ReadU8() == 1
		const delayTime = reader:ReadF32()
		return TweenInfo.new(
			time,
			(Enum.EasingStyle :: any)[easingStyle],
			(Enum.EasingDirection :: any)[easingDirection],
			repeatCount,
			reverses,
			delayTime
		)
	elseif tag == TypeTag.DateTime then
		return DateTime.fromUnixTimestampMillis(reader:ReadF64())
	elseif tag == TypeTag.Ray then
		const ox = reader:ReadF32()
		const oy = reader:ReadF32()
		const oz = reader:ReadF32()
		const dx = reader:ReadF32()
		const dy = reader:ReadF32()
		const dz = reader:ReadF32()
		return Ray.new(Vector3.new(ox, oy, oz), Vector3.new(dx, dy, dz))
	elseif tag == TypeTag.Region3 then
		const minX = reader:ReadF32()
		const minY = reader:ReadF32()
		const minZ = reader:ReadF32()
		const maxX = reader:ReadF32()
		const maxY = reader:ReadF32()
		const maxZ = reader:ReadF32()
		return Region3.new(Vector3.new(minX, minY, minZ), Vector3.new(maxX, maxY, maxZ))
	elseif tag == TypeTag.Region3int16 then
		const minX = reader:ReadI16()
		const minY = reader:ReadI16()
		const minZ = reader:ReadI16()
		const maxX = reader:ReadI16()
		const maxY = reader:ReadI16()
		const maxZ = reader:ReadI16()
		return Region3int16.new(Vector3int16.new(minX, minY, minZ), Vector3int16.new(maxX, maxY, maxZ))
	elseif tag == TypeTag.Faces then
		const mask = reader:ReadU8()
		const present = {}
		for index, normalId in NORMAL_IDS do
			if bit32.band(mask, bit32.lshift(1, index - 1)) ~= 0 then
				present[#present + 1] = normalId
			end
		end
		return Faces.new(table.unpack(present))
	elseif tag == TypeTag.Axes then
		const mask = reader:ReadU8()
		const present = {}
		for index, axis in AXES do
			if bit32.band(mask, bit32.lshift(1, index - 1)) ~= 0 then
				present[#present + 1] = axis
			end
		end
		return Axes.new(table.unpack(present))
	elseif tag == TypeTag.Instance then
		const index = reader:ReadU32()
		return refs and refs[index] or nil
	elseif tag == TypeTag.Array then
		const length = reader:ReadU32()
		if length > reader:Remaining() then
			error(`Serial: array length {length} exceeds remaining buffer size`)
		end
		const result = table.create(length)
		for index = 1, length do
			result[index] = Codec.ReadValue(reader, refs, currentDepth + 1)
		end
		return result
	elseif tag == TypeTag.Map then
		const count = reader:ReadU32()
		if count > reader:Remaining() then
			error(`Serial: map entry count {count} exceeds remaining buffer size`)
		end
		const result = {}
		for _ = 1, count do
			const key = Codec.ReadValue(reader, refs, currentDepth + 1)
			const mapValue = Codec.ReadValue(reader, refs, currentDepth + 1)
			result[key] = mapValue
		end
		return result
	else
		error(`Serial: unknown type tag {tag}`)
	end
end

return Codec
]]></ProtectedString>
