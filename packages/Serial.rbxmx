		<Item class="ModuleScript" referent="RBXD2D7DDFD8A9A4E4E985205606D467C2E">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[const Remotes = require("./Remotes")
const Links = require("./Links")

const runService = Remotes.RunService
const reliableRemoteEvent = Remotes.ReliableRemoteEvent
const unreliableRemoteEvent = Remotes.UnreliableRemoteEvent
const remoteFunction = Remotes.RemoteFunction

if runService:IsServer() then
	const function onReliableEvent(player: Player, eventId: string, rawBuffer: buffer, refs: { Instance }?)
		const self = Links[eventId]
		if not self then
			return
		end

		self.RawReceived:Fire(player, rawBuffer)
		self.Received:Fire(player, self:Deserialize(rawBuffer, refs))
	end

	reliableRemoteEvent.OnServerEvent:Connect(onReliableEvent)
	unreliableRemoteEvent.OnServerEvent:Connect(onReliableEvent)

	remoteFunction.OnServerInvoke = function(player: Player, eventId: string, rawBuffer: buffer, refs: { Instance }?): ...any
		const self = Links[eventId]
		if not self then
			return buffer.create(0)
		end

		const responses = self.Requested:Invoke(player, self:Deserialize(rawBuffer, refs))
		if responses[1] == nil then
			return buffer.create(0)
		end

		const responseBuffer, responseRefs = self:Serialize(responses[1])
		return responseBuffer, responseRefs
	end
else
	const function onReliableEvent(eventId: string, rawBuffer: buffer, refs: { Instance }?)
		const self = Links[eventId]
		if not self then
			return
		end

		self.RawReceived:Fire(rawBuffer)
		self.Received:Fire(self:Deserialize(rawBuffer, refs))
	end
	
	remoteFunction.OnClientInvoke = function(player: Player, eventId: string, rawBuffer: buffer, refs: { Instance }?): ...any
		const self = Links[eventId]
		if not self then
			return buffer.create(0)
		end

		const responses = self.Requested:Invoke(player, self:Deserialize(rawBuffer, refs))
		if responses[1] == nil then
			return buffer.create(0)
		end

		const responseBuffer, responseRefs = self:Serialize(responses[1])
		return responseBuffer, responseRefs
	end

	reliableRemoteEvent.OnClientEvent:Connect(onReliableEvent)
	unreliableRemoteEvent.OnClientEvent:Connect(onReliableEvent)
end

return true
]]></ProtectedString>
