				<ProtectedString name="Source"><![CDATA[--!strict

const BufferWriter = {}
const BufferWriterMethods = {}

function BufferWriter.new(capacity: number?): BufferWriter
	return setmetatable({
		Buffer = buffer.create(capacity or 64),
		Length = 0,
		Refs = {} :: { Instance },
	}, { __index = BufferWriterMethods })
end

function BufferWriterMethods.EnsureCapacity(self: BufferWriter, extra: number)
	const required = self.Length + extra
	const capacity = buffer.len(self.Buffer)

	if required > capacity then
		local newCapacity = capacity * 2
		while newCapacity < required do
			newCapacity *= 2
		end

		const newBuffer = buffer.create(newCapacity)
		buffer.copy(newBuffer, 0, self.Buffer, 0, self.Length)
		self.Buffer = newBuffer
	end
end

function BufferWriterMethods.WriteU8(self: BufferWriter, value: number)
	self:EnsureCapacity(1)
	buffer.writeu8(self.Buffer, self.Length, value)
	self.Length += 1
end

function BufferWriterMethods.WriteI16(self: BufferWriter, value: number)
	self:EnsureCapacity(2)
	buffer.writei16(self.Buffer, self.Length, value)
	self.Length += 2
end

function BufferWriterMethods.WriteU32(self: BufferWriter, value: number)
	self:EnsureCapacity(4)
	buffer.writeu32(self.Buffer, self.Length, value)
	self.Length += 4
end

function BufferWriterMethods.WriteI32(self: BufferWriter, value: number)
	self:EnsureCapacity(4)
	buffer.writei32(self.Buffer, self.Length, value)
	self.Length += 4
end

function BufferWriterMethods.WriteF32(self: BufferWriter, value: number)
	self:EnsureCapacity(4)
	buffer.writef32(self.Buffer, self.Length, value)
	self.Length += 4
end

function BufferWriterMethods.WriteF64(self: BufferWriter, value: number)
	self:EnsureCapacity(8)
	buffer.writef64(self.Buffer, self.Length, value)
	self.Length += 8
end

function BufferWriterMethods.WriteString(self: BufferWriter, value: string)
	const length = #value
	self:WriteU32(length)
	self:EnsureCapacity(length)
	buffer.writestring(self.Buffer, self.Length, value)
	self.Length += length
end

function BufferWriterMethods.WriteInstance(self: BufferWriter, value: Instance)
	const refs = self.Refs
	refs[#refs + 1] = value
	self:WriteU32(#refs)
end

function BufferWriterMethods.Finalize(self: BufferWriter): buffer
	const final = buffer.create(self.Length)
	buffer.copy(final, 0, self.Buffer, 0, self.Length)
	return final
end

export type BufferWriter = setmetatable<{
	Buffer: buffer,
	Length: number,
	Refs: { Instance },
}, { __index: typeof(BufferWriterMethods) }>

return BufferWriter
]]></ProtectedString>
