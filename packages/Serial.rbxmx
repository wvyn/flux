				<ProtectedString name="Source"><![CDATA[--!strict

const BufferReader = {}
const BufferReaderMethods = {}

function BufferReader.new(sourceBuffer: buffer): BufferReader
	return setmetatable({
		Buffer = sourceBuffer,
		Position = 0,
	}, { __index = BufferReaderMethods })
end

function BufferReaderMethods.Remaining(self: BufferReader): number
	return buffer.len(self.Buffer) - self.Position
end

function BufferReaderMethods.ReadU8(self: BufferReader): number
	const value = buffer.readu8(self.Buffer, self.Position)
	self.Position += 1
	return value
end

function BufferReaderMethods.ReadI16(self: BufferReader): number
	const value = buffer.readi16(self.Buffer, self.Position)
	self.Position += 2
	return value
end

function BufferReaderMethods.ReadU32(self: BufferReader): number
	const value = buffer.readu32(self.Buffer, self.Position)
	self.Position += 4
	return value
end

function BufferReaderMethods.ReadI32(self: BufferReader): number
	const value = buffer.readi32(self.Buffer, self.Position)
	self.Position += 4
	return value
end

function BufferReaderMethods.ReadF32(self: BufferReader): number
	const value = buffer.readf32(self.Buffer, self.Position)
	self.Position += 4
	return value
end

function BufferReaderMethods.ReadF64(self: BufferReader): number
	const value = buffer.readf64(self.Buffer, self.Position)
	self.Position += 8
	return value
end

function BufferReaderMethods.ReadString(self: BufferReader): string
	const length = self:ReadU32()
	if length > self:Remaining() then
		error(`Serial: string length {length} exceeds remaining buffer size`)
	end
	const value = buffer.readstring(self.Buffer, self.Position, length)
	self.Position += length
	return value
end

export type BufferReader = setmetatable<{
	Buffer: buffer,
	Position: number,
}, { __index: typeof(BufferReaderMethods) }>

return BufferReader
]]></ProtectedString>
