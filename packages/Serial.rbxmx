			<ProtectedString name="Source"><![CDATA[--[[ Serial by wyverndayo ]]

const Signal = require("./Signal")

const BufferWriter = require("@self/BufferWriter")
const BufferReader = require("@self/BufferReader")
const Codec = require("@self/Codec")
const Links = require("@self/Links")
const Remotes = require("@self/Remotes")
require("@self/Network")

const reliableRemoteEvent = Remotes.ReliableRemoteEvent
const unreliableRemoteEvent = Remotes.UnreliableRemoteEvent
const remoteFunction = Remotes.RemoteFunction
const eventFunctionName = Remotes.EventFunctionName
const eventGlobalFunctionName = Remotes.EventGlobalFunctionName
const runService = Remotes.RunService

--

const SerialSharedMethods = {}

function SerialSharedMethods.Serialize<data...>(self: SerialServer<data...> | SerialClient<data...>, ...: data...): (buffer, { Instance })
	const writer = BufferWriter.new()
	const count = select("#", ...)

	writer:WriteU8(count)
	for index = 1, count do
		Codec.WriteValue(writer, (select(index, ...)))
	end

	return writer:Finalize(), writer.Refs
end

function SerialSharedMethods.Deserialize<data...>(self: SerialServer<data...> | SerialClient<data...>, rawBuffer: buffer, refs: { Instance }?): data...
	const reader = BufferReader.new(rawBuffer)
	const count = reader:ReadU8()

	const results = table.create(count)
	for index = 1, count do
		results[index] = Codec.ReadValue(reader, refs)
	end

	return (table.unpack(results, 1, count) :: any)
end

--

const SerialServerMethods = setmetatable({}, { __index = SerialSharedMethods })

function SerialServerMethods.SendGlobalTCP<data...>(self: SerialServer<data...>, ...: data...)
	const serialized, refs = self:Serialize(...)
	reliableRemoteEvent[eventGlobalFunctionName](reliableRemoteEvent, self.EventId, serialized, refs)
end

function SerialServerMethods.SendGlobalUDP<data...>(self: SerialServer<data...>, ...: data...)
	const serialized, refs = self:Serialize(...)
	unreliableRemoteEvent[eventGlobalFunctionName](unreliableRemoteEvent, self.EventId, serialized, refs)
end

function SerialServerMethods.SendTCP<data...>(self: SerialServer<data...>, player: Player, ...: data...)
	const serialized, refs = self:Serialize(...)
	reliableRemoteEvent[eventFunctionName](reliableRemoteEvent, player, self.EventId, serialized, refs)
end

function SerialServerMethods.SendUDP<data...>(self: SerialServer<data...>, player: Player, ...: data...)
	const serialized, refs = self:Serialize(...)
	unreliableRemoteEvent[eventFunctionName](unreliableRemoteEvent, player, self.EventId, serialized, refs)
end

function SerialServerMethods.Request<data...>(self: SerialServer<data...>, player: Player, ...: data...): data...
	const serialized, refs = self:Serialize(...)
	const responseBuffer, responseRefs = remoteFunction:InvokeClient(player, self.EventId, serialized, refs)
	return self:Deserialize(responseBuffer, responseRefs)
end

--

const SerialClientMethods = setmetatable({}, { __index = SerialSharedMethods })

function SerialClientMethods.SendTCP<data...>(self: SerialClient<data...>, ...: data...)
	const serialized, refs = self:Serialize(...)
	reliableRemoteEvent[eventFunctionName](reliableRemoteEvent, self.EventId, serialized, refs)
end

function SerialClientMethods.SendUDP<data...>(self: SerialClient<data...>, ...: data...)
	const serialized, refs = self:Serialize(...)
	unreliableRemoteEvent[eventFunctionName](unreliableRemoteEvent, self.EventId, serialized, refs)
end

function SerialClientMethods.Request<data...>(self: SerialClient<data...>, ...: data...): data...
	const serialized, refs = self:Serialize(...)
	const responseBuffer, responseRefs = remoteFunction:InvokeServer(self.EventId, serialized, refs)
	return self:Deserialize(responseBuffer, responseRefs)
end

--

const Serial = {
	_links = Links,
	
	Server = {},
	Client = {}
}

function Serial.Server.new<data...>(eventId: string): SerialServer<data...>
	if Links[eventId] then
		return Links[eventId]
	end

	local self = setmetatable({
		EventId = eventId,

		RawReceived = Signal.new() :: Signal.Signal<Player, buffer>,
		Received = Signal.new() :: Signal.Signal<Player, data...>,
		Requested = Signal.new() :: Signal.Signal<Player, data...>,
	}, { __index = SerialServerMethods })
	
	Links[eventId] = self
	return self
end

function Serial.Client.new<data...>(eventId: string): SerialClient<data...>
	if Links[eventId] then
		return Links[eventId]
	end

	local self = setmetatable({
		EventId = eventId,

		RawReceived = Signal.new() :: Signal.Signal<buffer>,
		Received = Signal.new() :: Signal.Signal<data...>,
		Requested = Signal.new() :: Signal.Signal<data...>,
	}, { __index = SerialClientMethods })

	Links[eventId] = self
	return self
end

--

export type _serialServerMethods<data...> = {
	read SendGlobalTCP: (self: SerialServer<data...>, data...) -> (),
	read SendGlobalUDP: (self: SerialServer<data...>, data...) -> (),

	read SendTCP: (self: SerialServer<data...>, player: Player, data...) -> (),
	read SendUDP: (self: SerialServer<data...>, player: Player, data...) -> (),
	
	read Request: (self: SerialServer<data...>, data...) -> data...,
	
	read Serialize: (self: SerialServer<data...>, data...) -> (buffer, { Instance }),
	read Deserialize: (self: SerialServer<data...>, rawBuffer: buffer, refs: { Instance }?) -> data...,
}

export type _serialClientMethods<data...> = {
	read SendTCP: (self: SerialClient<data...>, data...) -> (),
	read SendUDP: (self: SerialClient<data...>, data...) -> (),

	read Request: (self: SerialClient<data...>, data...) -> data...,
	
	read Serialize: (self: SerialClient<data...>, data...) -> (buffer, { Instance }),
	read Deserialize: (self: SerialClient<data...>, rawBuffer: buffer, refs: { Instance }?) -> data...,
}

export type SerialServer<data...> = setmetatable<{
	read EventId: string,

	read RawReceived: Signal.Signal<Player, buffer>,
	read Received: Signal.Signal<Player, data...>,
	read Requested: Signal.Signal<Player, data...>,
}, { __index: _serialServerMethods<data...> }>

export type SerialClient<data...> = setmetatable<{
	read EventId: string,

	read RawReceived: Signal.Signal<buffer>,
	read Received: Signal.Signal<data...>,
}, { __index: _serialClientMethods<data...> }>

return Serial
]]></ProtectedString>
