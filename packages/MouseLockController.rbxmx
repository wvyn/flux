			<ProtectedString name="Source"><![CDATA[--!strict
--[[
	MouseLockController - Replacement for ShiftLockController, manages use of mouse-locked mode
	2026 Camera Update - Wyvern

	-- Spring (inlined from the standalone Spring module)
]]

local spring = {}
spring.__index = spring

export type Spring = {
	[string]: any,
}

function spring.new(initial: any, clock: (() -> number)?): Spring
	local target = initial or 0
	local resolvedClock: () -> number = clock or os.clock
	return setmetatable({
		_clock = resolvedClock,
		_time0 = resolvedClock(),
		_position0 = target,
		_velocity0 = 0 * target,
		_target = target,
		_damper = 1,
		_speed = 1,
	}, spring) :: Spring
end

function spring.Impulse(self: Spring, velocity: any)
	self.Velocity = self.Velocity + velocity
end

function spring.TimeSkip(self: Spring, delta: number)
	local now = self._clock()
	local position, velocity = self:_positionVelocity(now + delta)
	self._position0 = position
	self._velocity0 = velocity
	self._time0 = now
end

function spring.__index(self: Spring, index: string): any
	if spring[index] then
		return spring[index]
	elseif index == "Value" or index == "Position" or index == "p" then
		local position, _ = self:_positionVelocity(self._clock())
		return position
	elseif index == "Velocity" or index == "v" then
		local _, velocity = self:_positionVelocity(self._clock())
		return velocity
	elseif index == "Target" or index == "t" then
		return self._target
	elseif index == "Damper" or index == "d" then
		return self._damper
	elseif index == "Speed" or index == "s" then
		return self._speed
	elseif index == "Clock" then
		return self._clock
	else
		error(("%q is not a valid member of Spring"):format(tostring(index)), 2)
	end
end

function spring.__newindex(self: Spring, index: string, value: any)
	local now = self._clock()

	if index == "Value" or index == "Position" or index == "p" then
		local _, velocity = self:_positionVelocity(now)
		self._position0 = value
		self._velocity0 = velocity
		self._time0 = now
	elseif index == "Velocity" or index == "v" then
		local position, _ = self:_positionVelocity(now)
		self._position0 = position
		self._velocity0 = value
		self._time0 = now
	elseif index == "Target" or index == "t" then
		local position, velocity = self:_positionVelocity(now)
		self._position0 = position
		self._velocity0 = velocity
		self._target = value
		self._time0 = now
	elseif index == "Damper" or index == "d" then
		local position, velocity = self:_positionVelocity(now)
		self._position0 = position
		self._velocity0 = velocity
		self._damper = value
		self._time0 = now
	elseif index == "Speed" or index == "s" then
		local position, velocity = self:_positionVelocity(now)
		self._position0 = position
		self._velocity0 = velocity
		self._speed = if value < 0 then 0 else value
		self._time0 = now
	elseif index == "Clock" then
		local position, velocity = self:_positionVelocity(now)
		self._position0 = position
		self._velocity0 = velocity
		self._clock = value
		self._time0 = value()
	else
		error(("%q is not a valid member of Spring"):format(tostring(index)), 2)
	end
end

function spring._positionVelocity(self: Spring, now: number): (any, any)
	local p0 = self._position0
	local v0 = self._velocity0
	local p1 = self._target
	local d = self._damper
	local s = self._speed

	local t = s * (now - self._time0)
	local d2 = d * d

	local h, si, co
	if d2 < 1 then
		h = math.sqrt(1 - d2)
		local ep = math.exp(-d * t) / h
		co, si = ep * math.cos(h * t), ep * math.sin(h * t)
	elseif d2 == 1 then
		h = 1
		local ep = math.exp(-d * t) / h
		co, si = ep, ep * t
	else
		h = math.sqrt(d2 - 1)
		local u = math.exp((-d + h) * t) / (2 * h)
		local v = math.exp((-d - h) * t) / (2 * h)
		co, si = u + v, u - v
	end

	local a0 = h * co + d * si
	local a1 = 1 - (h * co + d * si)
	local a2 = si / s

	local b0 = -s * si
	local b1 = s * si
	local b2 = h * co - d * si

	return a0 * p0 + a1 * p1 + a2 * v0, b0 * p0 + b1 * p1 + b2 * v0
end

--============================================================--
-- MouseLockController
--============================================================--

local commonUtils = require(script.Parent.Parent:WaitForChild("CommonUtils"))
local flagUtil = commonUtils.get("FlagUtil")

const defaultMouseLockCursor: string = "http://www.roblox.com/asset/?id=14500233914"
const cameraOffsetDefault: Vector3 = Vector3.new(1.75, 0.25, 0)
const characterSmoothRotation: boolean = false
const characterRotationSpeed: number = 4 
const transitionSpringDamper: number = 0.7
const cameraTransitionInSpeed: number = 20
const cameraTransitionOutSpeed: number = 20
const renderStepName: string = "MouseLockControllerOffsetSmoothing"

const inputContexts = script.Parent.Parent:WaitForChild("InputContexts")
const cameraContext = inputContexts:WaitForChild("CameraContext")
const mouseLockSwitchAction = cameraContext:WaitForChild("MouseLockSwitchAction") :: InputAction

--[[ Services ]]--
const players = game:GetService("Players")
const userInputService = game:GetService("UserInputService")
const runService = game:GetService("RunService")
const workspaceService = game:GetService("Workspace")
const settings = UserSettings() -- ignore warning
const gameSettings = settings.GameSettings

--[[ Imports ]]--
local cameraUtils = require(script.Parent:WaitForChild("CameraUtils"))

local fFlagUserFixStuckShiftLock: boolean = flagUtil.getUserFlag("UserFixStuckShiftLock")

--[[ The Module ]]--
local MouseLockController = {}
MouseLockController.__index = MouseLockController

function MouseLockController.new(): MouseLockController
	assert(players.LocalPlayer, "No player found")
	
	local self = setmetatable({}, MouseLockController) :: MouseLockController

	self.isMouseLocked = false
	self.savedMouseCursor = nil
	self.enabled = false

	self.mouseLockToggledEvent = Instance.new("BindableEvent")

	self.humanoid = nil
	self.rootPart = nil
	self.head = nil

	self.camOffsetSpring = spring.new(Vector3.new(0, 0, 0))
	self.camOffsetSpring.Damper = transitionSpringDamper
	self.camOffsetSpring.Speed = cameraTransitionOutSpeed
	self.camOffsetSpring.Target = Vector3.new(0, 0, 0)

	gameSettings.Changed:Connect(function(property: string)
		if property == "ControlMode" or property == "ComputerMovementMode" then
			self:UpdateMouseLockAvailability()
		end
	end)

	players.LocalPlayer:GetPropertyChangedSignal("DevEnableMouseLock"):Connect(function()
		self:UpdateMouseLockAvailability()
	end)

	players.LocalPlayer:GetPropertyChangedSignal("DevComputerMovementMode"):Connect(function()
		self:UpdateMouseLockAvailability()
	end)

	userInputService:GetPropertyChangedSignal("PreferredInput"):Connect(function()
		self:UpdateMouseLockAvailability()
	end)

	self:onCharacterAdded(players.LocalPlayer.Character)
	players.LocalPlayer.CharacterAdded:Connect(function(character: Model)
		self:onCharacterAdded(character)
	end)

	self:UpdateMouseLockAvailability()

	mouseLockSwitchAction.Pressed:Connect(function()
		self:OnMouseLockToggled()
	end)

	runService:BindToRenderStep(renderStepName, Enum.RenderPriority.Camera.Value + 2, function(dt: number)
		self:stepSmoothing(dt)
	end)

	return self
end

function MouseLockController.GetIsMouseLocked(self: MouseLockController): boolean
	return self.isMouseLocked
end

function MouseLockController.GetBindableToggleEvent(self: MouseLockController): RBXScriptSignal
	return self.mouseLockToggledEvent.Event
end

function MouseLockController.GetMouseLockOffset(self: MouseLockController): Vector3
	return self.camOffsetSpring.Position
end

function MouseLockController.UpdateMouseLockAvailability(self: MouseLockController)
	assert(players.LocalPlayer, "No player found")
	local devAllowsMouseLock = players.LocalPlayer.DevEnableMouseLock
	local devMovementModeIsScriptable = players.LocalPlayer.DevComputerMovementMode == Enum.DevComputerMovementMode.Scriptable
	local userHasMouseLockModeEnabled = gameSettings.ControlMode == Enum.ControlMode.MouseLockSwitch
	local userHasClickToMoveEnabled = gameSettings.ComputerMovementMode == Enum.ComputerMovementMode.ClickToMove
	local userUsingKeyboardAndMouse = userInputService.PreferredInput == Enum.PreferredInput.KeyboardAndMouse
	local mouseLockAvailable = userUsingKeyboardAndMouse
		and devAllowsMouseLock
		and userHasMouseLockModeEnabled
		and not userHasClickToMoveEnabled
		and not devMovementModeIsScriptable

	if mouseLockAvailable ~= self.enabled then
		self:EnableMouseLock(mouseLockAvailable)
	end
end

function MouseLockController.onCharacterAdded(self: MouseLockController, character: Model?)
	self.humanoid = nil
	self.rootPart = nil
	self.head = nil

	if not character then
		return
	end

	task.spawn(function()
		local humanoid = (character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)) :: Humanoid?
		local rootPart = (character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)) :: BasePart?
		local head = (character:FindFirstChild("Head") or character:WaitForChild("Head", 5)) :: BasePart?

		if players.LocalPlayer and character ~= players.LocalPlayer.Character then
			return
		end

		self.humanoid = humanoid
		self.rootPart = rootPart
		self.head = head
	end)
end

function MouseLockController.transitionLockOffset(self: MouseLockController, locked: boolean)
	if locked then
		self.camOffsetSpring.Speed = cameraTransitionInSpeed
		self.camOffsetSpring.Target = cameraOffsetDefault
	else
		self.camOffsetSpring.Speed = cameraTransitionOutSpeed
		self.camOffsetSpring.Target = Vector3.new(0, 0, 0)
	end
end

function MouseLockController.stepSmoothing(self: MouseLockController, dt: number)
	local humanoid = self.humanoid
	local rootPart = self.rootPart
	local head = self.head
	local locked = self:IsMouseLocked()

	if humanoid then
		humanoid.AutoRotate = not locked
	end

	local camera = workspaceService.CurrentCamera

	if camera and head then
		local camCFrame = camera.CFrame
		local distance = (head.Position - camCFrame.Position).Magnitude

		if distance > 1 then
			camera.CFrame = camera.CFrame * CFrame.new(self.camOffsetSpring.Position)

			if locked and userInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
				userInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			end
		end
	end

	if locked and humanoid and rootPart and camera and not humanoid.Sit then
		local rootJoint = rootPart:FindFirstChild("RootJoint") :: Motor6D?
		if rootJoint and rootJoint.Enabled then
			local _, y, _ = camera.CFrame:ToOrientation()

			if characterSmoothRotation then
				rootPart.CFrame = rootPart.CFrame:Lerp(CFrame.new(rootPart.Position) * CFrame.Angles(0, y, 0), dt * 5 * characterRotationSpeed)
			else
				rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, y, 0)
			end
		end
	end
end

function MouseLockController.OnMouseLockToggled(self: MouseLockController)
	self.isMouseLocked = not self.isMouseLocked

	self:transitionLockOffset(self.isMouseLocked)
	userInputService.MouseBehavior = if self.isMouseLocked then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default

	if self.isMouseLocked then
		local cursorImageValueObj = script:FindFirstChild("CursorImage") :: StringValue?
		if cursorImageValueObj and cursorImageValueObj:IsA("StringValue") and cursorImageValueObj.Value ~= "" then
			cameraUtils.setMouseIconOverride(cursorImageValueObj.Value)
		else
			if cursorImageValueObj then
				cursorImageValueObj:Destroy()
			end
			local newCursorImageValueObj = Instance.new("StringValue")
			newCursorImageValueObj.Name = "CursorImage"
			newCursorImageValueObj.Value = defaultMouseLockCursor
			newCursorImageValueObj.Parent = script
			cameraUtils.setMouseIconOverride(defaultMouseLockCursor)
		end
	else
		cameraUtils.restoreMouseIcon()
	end

	--self.mouseLockToggledEvent:Fire()
end

function MouseLockController.IsMouseLocked(self: MouseLockController): boolean
	return self.enabled and self.isMouseLocked
end

function MouseLockController.EnableMouseLock(self: MouseLockController, enable: boolean)
	if enable == self.enabled then
		return
	end

	self.enabled = enable
	if self.enabled then
		mouseLockSwitchAction.Enabled = true
	else
		cameraUtils.restoreMouseIcon()

		mouseLockSwitchAction.Enabled = false
		
		self:transitionLockOffset(false)
		userInputService.MouseBehavior = Enum.MouseBehavior.Default

		if self.humanoid then
			self.humanoid.AutoRotate = true
		end

		if fFlagUserFixStuckShiftLock then
			if self.isMouseLocked then
				self.isMouseLocked = false
				--self.mouseLockToggledEvent:Fire()
			end
		else
			if self.isMouseLocked then
				--self.mouseLockToggledEvent:Fire()
			end

			self.isMouseLocked = false
		end
	end
end

export type MouseLockController = typeof(setmetatable(
	{} :: {
		isMouseLocked: boolean,
		savedMouseCursor: string?,
		enabled: boolean,
		mouseLockToggledEvent: BindableEvent,
		humanoid: Humanoid?,
		rootPart: BasePart?,
		head: BasePart?,
		camOffsetSpring: Spring,
	},
	MouseLockController
	))

return MouseLockController]]></ProtectedString>
