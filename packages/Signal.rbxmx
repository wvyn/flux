<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="ModuleScript" referent="RBX81BA8AE88CE8418589DCA12729E06055">
		<Properties>
			<Content name="LinkedSource"><null></null></Content>
			<ProtectedString name="Source"><![CDATA[--[[ Signal by wyverndayo ]]
--!strict

const taskSpawn = task.spawn
const taskDelay = task.delay
const taskCancel = task.cancel

const tableFind = table.find
const tableRemove = table.remove

const coroutineStatus = coroutine.status
const coroutineRunning = coroutine.running
const coroutineYield = coroutine.yield

--

const SignalConnectionConstructor = {}
const SignalConnectionMethods = {}

function SignalConnectionConstructor.new<T...>(callback: (T...) -> (...any), connections: { SignalConnection<T...> }): SignalConnection<T...>
	const SignalConnection = setmetatable({
		IsConnected = true,
		Connections = connections,
		Callback = callback
	}, { __index = SignalConnectionMethods })
	return SignalConnection
end

function SignalConnectionMethods.Disconnect<T...>(self: SignalConnection<T...>)
	if self.IsConnected then
		(self :: any).IsConnected = false
	end
	
	const connections = self.Connections
	const connectionIndex = tableFind(connections, self)
	if connectionIndex then
		tableRemove(connections, connectionIndex)
	end
end

--

const SignalConstructor = {}
const SignalMethods = {}

function SignalConstructor.new<T...>(... : T...): Signal<T...>
	return setmetatable({
		Connections = {} :: { SignalConnection<T...> }
	}, { __index = SignalMethods :: _signalMethods<T...> })
end

function SignalMethods.Destroy<T...>(self: Signal<T...>)
	self:DisconnectAll()
	setmetatable(self, nil)
end

function SignalMethods.Fire<T...>(self: Signal<T...>, ...: T...): T...
	for _, connection in next, self.Connections do
		taskSpawn(connection.Callback, ...)
	end; return ...
end

function SignalMethods.Invoke<T...>(self: Signal<T...>, ...: T...): { any }
	const responses = {}
	for _, connection in next, self.Connections do
		responses[#responses + 1] = connection.Callback(...)
	end; return responses
end


function SignalMethods.Connect<T...>(self: Signal<T...>, callback: (T...) -> (...any))
	const connections = self.Connections
	
	const SignalConnection = SignalConnectionConstructor.new(callback, connections)
	connections[#connections + 1] = SignalConnection
	
	return SignalConnection
end

function SignalMethods.DisconnectAll<T...>(self: Signal<T...>)
	const connections = self.Connections
	for connectionIndex, connection in next, connections do
		(connection :: any).IsConnected = false
		connections[connectionIndex] = nil
	end
end

function SignalMethods.Wait<T...>(self: Signal<T...>, timeout: number?)
	const thread = coroutineRunning()

	local connection: SignalConnection<T...>

	local timeoutThread: thread?
	if timeout then
		timeoutThread = taskDelay(timeout, function() 
			connection:Disconnect() 
			timeoutThread = nil

			if coroutineStatus(thread) == "suspended" then
				taskSpawn(thread)
			end
		end)
	end

	connection = self:Connect(function(...: T...)
		connection:Disconnect()
		if coroutineStatus(thread) == "suspended" then
			taskSpawn(thread, ...)
		end
		
		if timeoutThread then 
			taskCancel(timeoutThread);
			timeoutThread = nil 
		end
	end)

	return coroutineYield()
end

function SignalMethods.Once<T...>(self: Signal<T...>, callback: (T...) -> (...any))
	local connection: SignalConnection<T...>
	connection = self:Connect(function(...: T...)
		connection:Disconnect()
		taskSpawn(callback, ...)
	end)

	return connection
end

--

export type _signalMethods<T...> = {
	read Destroy: (self: Signal<T...>) -> (),
	
	read Fire: (self: Signal<T...>, T...) -> T...,
	read Invoke: (self: Signal<T...>, T...) -> { any },
	
	read Connect: (self: Signal<T...>, callback: (T...) -> (...any)) -> SignalConnection<T...>,
	read DisconnectAll: (self: Signal<T...>) -> (),
	
	read Wait: (self: Signal<T...>, timeout: number?) -> T...,
	read Once: (self: Signal<T...>, callback: (T...) -> (...any)) -> SignalConnection<T...>,
}

export type Signal<T...> = setmetatable<{
	read Connections: { SignalConnection<T...> },
}, {
	__index: _signalMethods<T...>
}>

export type _signalConnectionMethods<T...> = {
	Disconnect: (self: SignalConnection<T...>) -> (),
}

export type SignalConnection<T...> = setmetatable<{
	read IsConnected: boolean,
	read Connections: { SignalConnection<T...> },

	read Callback: (T...) -> (...any),

}, {
	__index: _signalConnectionMethods<T...>
}>

return SignalConstructor]]></ProtectedString>
